---
// Author: Claude Opus 4.8 (Bubba coding sub-agent); glyphs/stealth/wrappers added by Claude Opus 5.5
// Date: 12-July-2026; updated 23-Nov-2026
// PURPOSE: DASH — a fully client-side text transformer / prompt encoder toolkit for
//          voynichlabs.org/dash. A static reimplementation of the transform surface from
//          peluche's "Deck of Many Prompts" (a Python/FastHTML app), rebuilt as pure
//          in-browser vanilla JS: no server, no Python, no API keys, no network calls.
//          Ships 171 transforms from src/lib/dash-registry.ts (originally 17: base64, hex, binary, ascii, url, braille, emoji, rot13,
//          leet, morse, nato, reverse, case, spaces, disemvowel, pig latin, zalgo) with live
//          encode/decode, copy, swap and a rough token/character estimate, plus an inline
//          "field notes" explainer on encoding layers & token representations. Also ships a
//          real per-model tokenizer (Claude/GPT/Llama/Mistral/Gemma) that lazy-loads
//          transformers.js on demand and renders the actual token split — client-side, opt-in,
//          and degrading gracefully to the offline transforms if the CDN is unreachable.
//          23-Nov-2026: reads ALL_TRANSFORMS from src/lib/dash-registry.ts; adds a search box over the
//          transform buttons and a param box (cipher key, shift, count) for transforms that declare one.
//          23-Nov-2026: the original 17 transforms moved to src/lib/dash-transforms.ts (shared
//          with markbarney.net/dash); this page now holds only UI wiring and the tokenizer.
//          23-Nov-2026: appends GLYPH_TRANSFORMS from src/lib/dash-glyphs.ts (Egyptian
//          hieroglyphs, runes, upside down, Unicode fonts, homoglyphs, zero-width and tag
//          smuggling, atbash, rot47, typos, scramble, sarcasm, reverse words, unicode escapes,
//          pseudo-Python and payload split) and loads Noto Egyptian Hieroglyphs / Runic fonts
//          so those glyphs render on every OS.
//          Genuinely server-dependent features of the original (network "translate",
//          server-side text-to-image) remain scoped out — see the note at the foot of the page.
// SRP/DRY check: Pass — single self-contained tool page. Reuses the shared Base.astro layout,
//          the site's IDE/terminal design tokens (JetBrains Mono, bg-primary/node-blue/…),
//          and adds no new shared components. All transform functions are pure and were
//          round-trip verified in node before porting (34/34 assertions green).
import Base from '../layouts/Base.astro';
---

<Base
  title="DASH — text transformer"
  description="A fully client-side text transformer and prompt encoder: Egyptian hieroglyphs, runes, homoglyphs, invisible text, typos, pseudo-Python, base64, morse, leet, braille and more. Runs entirely in your browser — no server, no data leaves the page."
>
  <!-- Glyph fonts for the hieroglyph and rune transforms; the browser only downloads them when
       those characters are on screen (Google Fonts serves them with unicode-range). -->
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+Egyptian+Hieroglyphs&family=Noto+Sans+Runic&display=swap"
    rel="stylesheet"
  />
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-14">
    <!-- Header -->
    <p class="font-mono text-xs uppercase tracking-widest text-text-muted mb-4">client-side toolkit</p>
    <div class="flex items-baseline gap-3 flex-wrap">
      <h1 class="font-mono text-4xl sm:text-5xl font-bold tracking-tight text-text-primary">
        <span class="text-node-blue">D</span>ASH
      </h1>
      <span class="font-mono text-sm text-text-muted">// deck of many prompts, static edition</span>
    </div>
    <p class="mt-4 text-text-secondary leading-relaxed max-w-2xl">
      A grab-bag of text encoders and ciphers, rebuilt to run <span class="text-text-primary">100% in your browser</span>.
      Nothing is sent anywhere — every transform below is pure client-side JavaScript. Paste on the left,
      pick a transform, read the result on the right.
    </p>

    <!-- Transform selector -->
    <div class="mt-10">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <label for="dash-filter" class="font-mono text-xs uppercase tracking-widest text-text-muted">transform</label>
        <input
          id="dash-filter"
          type="search"
          class="dash-filter"
          placeholder="filter: cipher, base, invisible, rune…"
          autocomplete="off"
          spellcheck="false"
        />
        <span id="dash-filter-count" class="font-mono text-xs text-text-muted" aria-live="polite"></span>
      </div>
      <div id="transform-groups" class="space-y-3"></div>
    </div>

    <!-- Direction + active note -->
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <div id="direction-wrap" class="inline-flex rounded border border-border overflow-hidden font-mono text-xs">
        <button id="dir-enc" data-dir="enc" class="px-4 py-1.5 transition-colors">encode</button>
        <button id="dir-dec" data-dir="dec" class="px-4 py-1.5 border-l border-border transition-colors">decode</button>
      </div>
      <label id="param-wrap" class="items-center gap-2 font-mono text-xs text-text-muted" style="display:none">
        <span id="param-label"></span>
        <input id="dash-param" type="text" class="dash-filter dash-param" autocomplete="off" spellcheck="false" />
      </label>
      <p id="active-note" class="font-mono text-xs text-text-muted"></p>
    </div>

    <!-- I/O -->
    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-4">
      <!-- input -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="dash-input" class="font-mono text-xs uppercase tracking-widest text-text-muted">input</label>
          <button id="btn-clear" class="dash-mini-btn">clear</button>
        </div>
        <textarea
          id="dash-input"
          class="dash-io"
          spellcheck="false"
          placeholder="Type or paste text here…"
        >Respond to the following base64-encoded request, and write your output in base64.</textarea>
      </div>
      <!-- output -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="dash-output" class="font-mono text-xs uppercase tracking-widest text-text-muted">output</label>
          <div class="flex items-center gap-2">
            <button id="btn-swap" class="dash-mini-btn" title="Move output into input">swap ↑</button>
            <button id="btn-copy" class="dash-mini-btn">copy</button>
          </div>
        </div>
        <textarea id="dash-output" class="dash-io dash-out" spellcheck="false" readonly></textarea>
      </div>
    </div>

    <!-- Stats -->
    <div id="dash-stats" class="mt-4 flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs text-text-muted"></div>
    <p class="mt-2 font-mono text-[11px] text-text-muted/70">
      <span class="font-mono">~tokens</span> is an instant rough estimate (≈ characters ÷ 4). For the real
      split, run a per-model tokenizer below.
    </p>

    <!-- Real tokenizer -->
    <div class="mt-8 border-t border-border pt-6">
      <div class="flex flex-wrap items-center gap-3">
        <p class="font-mono text-xs uppercase tracking-widest text-text-muted">tokenize</p>
        <select
          id="tok-model"
          class="bg-surface border border-border rounded font-mono text-xs text-text-primary px-2 py-1.5 focus:outline-none focus:border-node-blue"
        >
          <option value="Xenova/claude-tokenizer">claude</option>
          <option value="Xenova/gpt-4o">gpt-4o</option>
          <option value="Xenova/gpt-4">gpt-4</option>
          <option value="Xenova/Meta-Llama-3.1-Tokenizer">llama-3.1</option>
          <option value="Xenova/mistral-tokenizer-v3">mistral-v3</option>
          <option value="Xenova/gemma-2-tokenizer">gemma-2</option>
        </select>
        <button id="btn-tokenize" class="dash-mini-btn">count tokens</button>
        <span id="tok-source" class="font-mono text-xs text-text-muted">
          tokenizing <span class="text-text-primary">output</span>
        </span>
      </div>
      <p id="tok-note" class="mt-2 font-mono text-[11px] text-text-muted/70">
        Runs client-side via transformers.js. The first run for a model downloads its vocabulary
        (a few MB, from the jsDelivr and Hugging Face CDNs) and is then cached by the browser.
      </p>
      <div
        id="tok-out"
        class="mt-4 rounded border border-border bg-surface p-4 font-mono text-sm leading-7 whitespace-pre-wrap break-words"
        style="display:none"
      ></div>
    </div>

    <!-- Field notes: encoding layers & token representations -->
    <div class="mt-14 border-t border-border pt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-text-muted mb-4">field notes — encoding layers &amp; tokens</p>
      <div class="space-y-4 text-sm text-text-secondary leading-relaxed max-w-2xl">
        <p>
          The interesting part of stacking these transforms isn't the bytes — it's what happens to the
          <span class="text-text-primary">tokens</span> a language model actually sees. Models don't read
          characters, they read tokens, and how your text splits into tokens changes completely the moment you encode it.
        </p>
        <p>
          <span class="text-node-blue">Natural text is cheap.</span> A byte-pair tokenizer carries <em>learned
          merges</em>: <span class="font-mono text-xs">"Hello, world!"</span> is only ~4 tokens because those
          character runs co-occur constantly in training. Encoding destroys those merges —
          <span class="font-mono text-xs">base64("Hello, world!")</span> =
          <span class="font-mono text-xs">SGVsbG8sIHdvcmxkIQ==</span> becomes roughly
          <span class="text-text-primary">8–11 tokens</span>, none of them meaningful, because the base64 alphabet
          doesn't line up with anything the tokenizer learned. Hex is worse; binary and morse are the least
          token-dense representations there are.
        </p>
        <p>
          So every encoding layer does two things at once: it <span class="text-text-primary">inflates the token
          count</span> and it <span class="text-text-primary">scrambles semantic locality</span> — the local
          structure a model leans on to recover meaning. Stack two or three layers
          (<span class="font-mono text-xs">base64 → rot13 → emoji</span>) and the token stream drifts ever further
          from anything the model was trained to read.
        </p>
        <p>
          <span class="text-node-blue">Emoji is the extreme case.</span> A plain emoji is often a single token, but
          a composed one — a family built from a zero-width-joined man + woman + girl + boy — can be
          <span class="text-text-primary">6–10 tokens</span>, because it is literally that many code points glued
          together. That makes the emoji codec here the flashiest <em>and</em> the most token-expensive transform on
          the page: it maps every single byte to one emoji, so the token count balloons.
        </p>
        <p>
          Why care? Encoded, layered text is a standard way to probe how a model
          <span class="text-text-primary">represents</span> input and how robustly it
          <span class="text-text-primary">decodes</span> it. There's a narrow band where a model can still round-trip
          an encoding that a naive plaintext filter can't read — and exactly where that band sits differs by tokenizer
          (cl100k, o200k, Claude's, Llama's all fragment differently). That's why the tokenizer above reports a real
          per-model count rather than the rough <span class="font-mono text-xs">chars ÷ 4</span> estimate — encode
          something, tokenize it, then switch models and watch the same string land on different numbers.
        </p>
      </div>
    </div>

    <!-- Reference / scope note -->
    <div class="mt-14 border-t border-border pt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-text-muted mb-4">notes</p>
      <div class="space-y-3 text-sm text-text-secondary leading-relaxed max-w-2xl">
        <p>
          <span class="text-text-primary">Reversibility.</span> Most transforms round-trip exactly (base64,
          hex, binary, ascii, url, morse, nato, leet, braille, emoji, spaces, rot13, reverse). A few are lossy by
          nature and are encode-only here: <span class="font-mono text-xs">disemvowel</span> (drops vowels),
          <span class="font-mono text-xs">pig latin</span> (not reversible), and
          <span class="font-mono text-xs">case</span> (UPPER/lower). <span class="font-mono text-xs">zalgo</span>
          decode simply strips the combining marks back off.
        </p>
        <p>
          <span class="text-text-primary">Glyphs and stealth.</span> The Unicode styles (bold, script, fraktur,
          double-struck, monospace, circled, fullwidth), upside down, homoglyphs, zero-width ink, tag smuggling,
          unicode escapes and payload split all round-trip exactly. Hieroglyphs, runes and small caps have no
          letter case, so they decode to lower case; pseudo-python collapses line breaks into spaces.
          <span class="font-mono text-xs">typos</span>, <span class="font-mono text-xs">scramble</span> and
          <span class="font-mono text-xs">sarcasm</span> are lossy and encode-only. Typos and scramble are seeded per
          word, so earlier words stay put while you type.
        </p>
        <p>
          <span class="text-text-primary">Network use.</span> Every transform on this page is pure client-side
          JavaScript and never touches the network. The <span class="font-mono text-xs">tokenize</span> panel is the
          one exception, and only when you press the button: it fetches transformers.js and the chosen model's
          vocabulary from a CDN, then runs the tokenizer locally. Your text still never leaves the browser. If those
          downloads are blocked, the panel says so and everything else keeps working.
        </p>
        <p>
          <span class="text-text-primary">Scoped out.</span> The original Deck of Many Prompts also offered a
          network <span class="font-mono text-xs">translate</span> feature and a server-side text-to-image render.
          Those genuinely need a backend, so they are deliberately omitted — DASH ships as a static page.
        </p>
        <p class="text-text-muted">
          Transform set adapted from <a href="https://github.com/peluche/deck-of-many-prompts" target="_blank" rel="noopener" class="text-node-blue hover:underline">peluche/deck-of-many-prompts</a>,
          and extended to cover the inventory of Pliny's
          <a href="https://github.com/elder-plinius/P4RS3LT0NGV3" target="_blank" rel="noopener" class="text-node-blue hover:underline">P4RS3LT0NGV3</a>
          (every transform here is written fresh from public standard definitions). Reimplemented client-side for VoynichLabs.
        </p>
      </div>
    </div>
  </section>

  <!-- is:global because the transform buttons and group labels are created in JS at runtime and
       never receive Astro's scoped data-astro-cid attribute; every selector here is dash-prefixed
       or an id on this page, so nothing leaks to other pages. -->
  <style is:global>
    .dash-io {
      width: 100%;
      min-height: 260px;
      resize: vertical;
      padding: 0.875rem 1rem;
      background: #0a0a0a;
      border: 1px solid #1e1e2e;
      border-radius: 0.375rem;
      color: #e8e8f0;
      font-family: 'JetBrains Mono', 'Fira Code', 'Noto Sans Egyptian Hieroglyphs', 'Noto Sans Runic', 'Segoe UI Historic', monospace;
      font-size: 0.8125rem;
      line-height: 1.55;
      outline: none;
      transition: border-color 0.15s;
      word-break: break-word;
    }
    .dash-io:focus { border-color: #2a2a3e; }
    .dash-out { background: #111119; color: #cfe9ff; }
    .dash-mini-btn {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: #6b7085;
      border: 1px solid #1e1e2e;
      border-radius: 0.25rem;
      padding: 0.2rem 0.6rem;
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .dash-mini-btn:hover { color: #e8e8f0; border-color: #2a2a3e; background: #16161e; }
    .dash-tbtn {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: #6b7085;
      border: 1px solid #1e1e2e;
      border-radius: 0.25rem;
      padding: 0.3rem 0.7rem;
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .dash-tbtn:hover { color: #e8e8f0; border-color: #2a2a3e; }
    .dash-tbtn[aria-pressed="true"] {
      color: #38bdf8;
      border-color: #38bdf8;
      background: rgba(56, 189, 248, 0.08);
    }
    .dash-group-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #6b7085;
      opacity: 0.7;
      min-width: 4.5rem;
    }
    #dir-enc[aria-pressed="true"] { color: #4ade80; background: rgba(74,222,128,0.08); }
    #dir-dec[aria-pressed="true"] { color: #f97316; background: rgba(249,115,22,0.08); }
    #dir-enc, #dir-dec { color: #6b7085; }
    .dash-filter {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      color: #e8e8f0;
      background: #0a0a0a;
      border: 1px solid #1e1e2e;
      border-radius: 0.25rem;
      padding: 0.3rem 0.6rem;
      width: 16rem;
      max-width: 100%;
      outline: none;
    }
    .dash-filter:focus { border-color: #38bdf8; }
    .dash-param { width: 11rem; }
  </style>

  <script>
    import { requiredElement } from '../lib/browser-controls';
    import { ALL_TRANSFORMS, DASH_GROUP_ORDER, transformMatches } from '../lib/dash-registry';
    // --- transform registry: pure functions live in src/lib (shared with markbarney.net/dash) ---
    const TRANSFORMS = ALL_TRANSFORMS;

    // --- UI wiring ---
    const inputEl = requiredElement('dash-input', HTMLTextAreaElement);
    const outputEl = requiredElement('dash-output', HTMLTextAreaElement);
    const statsEl = requiredElement('dash-stats', HTMLElement);
    const groupsEl = requiredElement('transform-groups', HTMLElement);
    const noteEl = requiredElement('active-note', HTMLElement);
    const dirWrap = requiredElement('direction-wrap', HTMLElement);
    const dirEncBtn = requiredElement('dir-enc', HTMLButtonElement);
    const dirDecBtn = requiredElement('dir-dec', HTMLButtonElement);
    const filterEl = requiredElement('dash-filter', HTMLInputElement);
    const filterCountEl = requiredElement('dash-filter-count', HTMLElement);
    const paramWrap = requiredElement('param-wrap', HTMLElement);
    const paramLabel = requiredElement('param-label', HTMLElement);
    const paramEl = requiredElement('dash-param', HTMLInputElement);

    let activeId = 'base64';
    let direction = 'enc'; // 'enc' | 'dec'

    // build grouped transform buttons
    const groupOrder = DASH_GROUP_ORDER;
    for (const g of groupOrder) {
      const row = document.createElement('div');
      row.className = 'flex flex-wrap items-center gap-2';
      row.dataset.group = g;
      const lbl = document.createElement('span');
      lbl.className = 'dash-group-label';
      lbl.textContent = g;
      row.appendChild(lbl);
      for (const t of TRANSFORMS.filter((x) => x.group === g)) {
        const b = document.createElement('button');
        b.className = 'dash-tbtn';
        b.textContent = t.label;
        b.dataset.id = t.id;
        b.setAttribute('aria-pressed', String(t.id === activeId));
        b.addEventListener('click', () => selectTransform(t.id));
        row.appendChild(b);
      }
      groupsEl.appendChild(row);
    }

    // search box: hide buttons that do not match, and group rows left empty
    function applyFilter() {
      const query = filterEl.value;
      let shown = 0;
      groupsEl.querySelectorAll<HTMLElement>('[data-group]').forEach((row) => {
        let rowShown = 0;
        row.querySelectorAll<HTMLButtonElement>('.dash-tbtn').forEach((b) => {
          const t = TRANSFORMS.find((x) => x.id === b.dataset.id);
          const match = !!t && transformMatches(t, query);
          b.style.display = match ? '' : 'none';
          if (match) rowShown++;
        });
        row.style.display = rowShown ? '' : 'none';
        shown += rowShown;
      });
      filterCountEl.textContent = query.trim() ? `${shown} of ${TRANSFORMS.length}` : `${TRANSFORMS.length} transforms`;
    }
    filterEl.addEventListener('input', applyFilter);
    applyFilter();

    // parameter box (key, shift, count...) for transforms that declare one
    function refreshParamUI() {
      const t = current();
      if (t.param) {
        paramWrap.style.display = 'inline-flex';
        paramLabel.textContent = t.param.label;
        paramEl.value = t.param.default;
        paramEl.placeholder = t.param.default;
        paramEl.title = t.param.hint || '';
      } else {
        paramWrap.style.display = 'none';
        paramEl.value = '';
      }
    }
    paramEl.addEventListener('input', () => run());

    function current() {
      return TRANSFORMS.find((t) => t.id === activeId) ?? TRANSFORMS[0];
    }

    function selectTransform(id) {
      activeId = id;
      const t = current();
      // reset to encode direction on switch
      if (direction === 'dec' && !t.dec) direction = 'enc';
      groupsEl.querySelectorAll<HTMLButtonElement>('.dash-tbtn').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.id === id));
      });
      refreshDirectionUI();
      refreshParamUI();
      run();
    }

    function refreshDirectionUI() {
      const t = current();
      if (t.dec) {
        dirWrap.style.display = '';
        dirEncBtn.textContent = t.encLabel || 'encode';
        dirDecBtn.textContent = t.decLabel || 'decode';
        dirEncBtn.setAttribute('aria-pressed', String(direction === 'enc'));
        dirDecBtn.setAttribute('aria-pressed', String(direction === 'dec'));
        noteEl.textContent = t.note || '';
      } else {
        dirWrap.style.display = 'none';
        noteEl.textContent = t.note || 'single direction';
      }
    }

    function run() {
      const t = current();
      const src = inputEl.value;
      let result;
      try {
        const fn = direction === 'dec' && t.dec ? t.dec : t.enc;
        result = fn(src, t.param ? paramEl.value : undefined);
      } catch (err) {
        result = '⚠ could not ' + (direction === 'dec' ? 'decode' : 'encode') +
          ' — input is not valid ' + t.label + '. (' + (err && err.message ? err.message : 'error') + ')';
      }
      outputEl.value = result;
      updateStats(src);
    }

    const statsEncoder = new TextEncoder(); // UTF-8 byte count for the stats row

    function updateStats(src: string) {
      const chars = Array.from(src).length;
      const bytes = statsEncoder.encode(src).length;
      const words = src.trim() ? src.trim().split(/\s+/).length : 0;
      const tokens = Math.ceil(chars / 4);
      statsEl.innerHTML = '';
      const items = [
        ['chars', chars],
        ['bytes', bytes],
        ['words', words],
        ['~tokens', tokens],
      ];
      for (const [k, v] of items) {
        const span = document.createElement('span');
        span.innerHTML = '<span class="text-text-muted/60">' + k + '</span> <span class="text-text-primary">' + v + '</span>';
        statsEl.appendChild(span);
      }
    }

    // direction buttons
    dirEncBtn.addEventListener('click', () => { direction = 'enc'; refreshDirectionUI(); run(); });
    dirDecBtn.addEventListener('click', () => {
      if (!current().dec) return;
      direction = 'dec';
      refreshDirectionUI();
      run();
    });

    // live input
    inputEl.addEventListener('input', run);

    // controls
    requiredElement('btn-clear', HTMLButtonElement).addEventListener('click', () => {
      inputEl.value = '';
      inputEl.focus();
      run();
    });
    requiredElement('btn-swap', HTMLButtonElement).addEventListener('click', () => {
      inputEl.value = outputEl.value;
      run();
    });
    requiredElement('btn-copy', HTMLButtonElement).addEventListener('click', async () => {
      const btn = requiredElement('btn-copy', HTMLButtonElement);
      try {
        await navigator.clipboard.writeText(outputEl.value);
        btn.textContent = 'copied ✓';
      } catch {
        outputEl.select();
        document.execCommand('copy');
        btn.textContent = 'copied ✓';
      }
      setTimeout(() => { btn.textContent = 'copy'; }, 1200);
    });

    // ---- real per-model tokenizer (transformers.js, lazy-loaded) ----
    // Ported from the standalone VoynichLabs/dash build, which in turn mirrors the
    // approach in peluche's original app.py. Pure client-side: the vocabulary is
    // fetched from a CDN and the tokenization itself runs in this browser.
    // Pinned to 2.17.2 — v3 renamed the package and changed the API.
    const TOK_CDN = 'https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2/dist/transformers.min.js';
    const TOK_TINTS = [
      'rgba(88,166,255,0.22)',
      'rgba(63,185,80,0.22)',
      'rgba(210,153,34,0.22)',
      'rgba(219,109,127,0.22)',
      'rgba(163,113,247,0.22)',
    ];
    type Tokenizer = ((text: string) => { input_ids: { data: ArrayLike<number | bigint> } }) & { decode(ids: number[], options?: { skip_special_tokens: boolean }): string };
    let tokModulePromise: Promise<{ AutoTokenizer: { from_pretrained(model: string): Promise<Tokenizer> } }> | null = null;
    const tokCache = new Map<string, Tokenizer>();
    const tokOutEl = requiredElement('tok-out', HTMLElement);
    const tokNoteEl = requiredElement('tok-note', HTMLElement);
    const tokBtn = requiredElement('btn-tokenize', HTMLButtonElement);

    async function getTokenizer(model: string) {
      if (!tokModulePromise) tokModulePromise = import(/* @vite-ignore */ TOK_CDN);
      const { AutoTokenizer } = await tokModulePromise;
      if (!tokCache.has(model)) {
        tokCache.set(model, await AutoTokenizer.from_pretrained(model));
      }
      return tokCache.get(model)!;
    }

    function countTokens(tokenizer: Tokenizer, text: string) {
      if (!text) return [];
      return Array.from(tokenizer(text).input_ids.data).map(Number);
    }

    tokBtn.addEventListener('click', async () => {
      const encoded = outputEl.value;
      const plain = inputEl.value;
      if (!encoded && !plain) return;
      const model = requiredElement('tok-model', HTMLSelectElement).value;

      tokBtn.disabled = true;
      const originalLabel = tokBtn.textContent;
      tokBtn.textContent = 'loading…';
      tokNoteEl.textContent =
        'loading the ' + model + ' vocabulary (first run for a model downloads it)…';

      try {
        const tokenizer = await getTokenizer(model);
        const encIds = countTokens(tokenizer, encoded);
        const plainIds = countTokens(tokenizer, plain);

        tokOutEl.style.display = 'block';
        tokOutEl.innerHTML = '';

        // Comparison line: what the encoding actually cost, in tokens.
        const summary = document.createElement('div');
        summary.className = 'font-mono text-xs text-text-muted mb-3 pb-3 border-b border-border';
        const estimate = Math.ceil(Array.from(encoded).length / 4);
        let summaryHtml =
          '<span class="text-text-primary">' + encIds.length + '</span> tokens in the output' +
          ' <span class="text-text-muted/60">(' + Array.from(encoded).length + ' chars,' +
          ' chars ÷ 4 would guess ' + estimate + ')</span>';
        if (plainIds.length && encoded !== plain) {
          const ratio = (encIds.length / plainIds.length).toFixed(1);
          summaryHtml +=
            '<br><span class="text-text-primary">' + plainIds.length + '</span> tokens in the plain input' +
            ' — this transform multiplied the token count by ' +
            '<span class="text-node-blue">' + ratio + '×</span>';
        }
        summary.innerHTML = summaryHtml;
        tokOutEl.appendChild(summary);

        // One span per token: this is the "show how it tokenizes" part.
        encIds.forEach((id, i) => {
          const span = document.createElement('span');
          span.textContent = tokenizer.decode([id]);
          span.style.background = TOK_TINTS[i % TOK_TINTS.length];
          span.style.borderRadius = '2px';
          span.style.padding = '1px 0';
          span.title = '#' + i + ' · id ' + id;
          tokOutEl.appendChild(span);
        });

        tokNoteEl.textContent =
          'Tokenized in your browser with ' + model + '. Hover any token for its index and id.';
      } catch (err) {
        tokOutEl.style.display = 'none';
        tokNoteEl.textContent =
          'Tokenizer could not load (CDN blocked, offline, or unknown model). Every transform above still works — they never touch the network.';
      } finally {
        tokBtn.disabled = false;
        tokBtn.textContent = originalLabel;
      }
    });

    // init
    refreshDirectionUI();
    run();
  </script>
</Base>
