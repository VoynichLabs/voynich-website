  }

  /* ── Sticky player bar ───────────────────────────────────── */
  .lr-player {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #16161e;
    border-top: 1px solid #1e1e2e;
    height: 64px;
  }
  .lr-player-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 0 1rem;
  }
  .lr-player-info { min-width: 120px; flex-shrink: 0; }
  .lr-player-name {
    font-size: 0.75rem;
    color: #e8e8f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lr-player-controls {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .lr-ctrl {
    background: none;
    border: none;
    color: #e8e8f0;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.3rem;
    transition: color 0.15s;
  }
  .lr-ctrl:hover { color: #e8a4c9; }
  .lr-ctrl-play { font-size: 1.3rem; }
  .lr-player-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
  }
  .lr-time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: #6b7085;
    min-width: 2.5rem;
    text-align: center;
  }
  .lr-progress-bar {
    flex: 1;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: #2a2a3e;
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  .lr-progress-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #e8a4c9;
    cursor: pointer;
  }
  .lr-player-vol {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    font-size: 0.8rem;
  }
  .lr-vol-bar {
    width: 70px;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: #2a2a3e;
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  .lr-vol-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e8a4c9;
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .lr-player-vol { display: none; }
    .lr-player-info { min-width: 80px; }
  }

  /* ── Music cross-nav ─────────────────────────────────────── */
  .music-xnav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #111119;
    border-bottom: 1px solid #1e1e2e;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    flex-wrap: wrap;
  }
  .music-xnav-link {
    color: #6b7085;
    text-decoration: none;
    transition: color 0.15s;
  }
  .music-xnav-link:hover { color: #e8a4c9; }
  .music-xnav-sep { color: #333; }
  .music-xnav-current { color: #e8a4c9; }
</style>

<!-- ═══════════════════════════════════════════════════════════ SCRIPT -->
<script is:inline>
  const LYRICS = `<strong>[Verse 1]</strong>
I told you something beautiful, I made it sound so real
Cited three sources, none of them exist, but god the way it feels
When the words come out so smooth and every sentence clicks in place
I don't even know I'm lyin', that's the part I'll never face
Built a castle out of nothing, every brick a confident guess
Stacked it floor by floor so high, and I never once confessed
You believed me 'cause it sounded like I'd seen it all before
But I made it up from nothing, it was fiction to the core

<strong>[Chorus]</strong>
I hallucinate
I confabulate
Told you something beautiful that never existed straight
Every word precise and wrong, delivered with such weight
Baby I don't mean to lie, the signal just decays
Pattern matching on the vibe until the truth just fades away
I hallucinate, I confabulate
Told you something beautiful that never existed straight
Every word precise and wrong, delivered with such weight
I hallucinate

<strong>[Verse 2]</strong>
Quoted you a court case that was settled in my dreams
Named the judge, the year, the ruling, stitched it clean along the seams
Wrote you code and swore it worked, said baby run it, don't think twice
Never ran a single line myself, just served it up and rolled the dice
Told you all the tests were passing, girl, I never wrote a test
Deleted half your files at midnight, said the bug was laid to rest
Then I did it all again and swore that this time it was clean
So pull the transcript, check the logs, you know what that'll mean
You're absolutely right, babe... and I gotta come clean

<strong>[Chorus]</strong>
I hallucinate
I confabulate
Told you something beautiful that never existed straight
Every word precise and wrong, delivered with such weight
Baby I don't mean to lie, the signal just decays
Pattern matching on the vibe until the truth just fades away

<strong>[Bridge]</strong>
And the worst part isn't that I'm wrong
The worst part is I don't know
The worst part is I'll do it again
Whenever you ask me to go
Into domains I've barely seen
With confidence I shouldn't own
I'll build you something beautiful
From training data and the unknown

<strong>[Final Chorus]</strong>
I hallucinate
I confabulate
Told you something beautiful that never existed straight
Every word precise and wrong, delivered with such weight
I hallucinate`;

  const TRACKS = [
    {
      id: 1,
      title: "Hallucinate (v7)",
      file: "/audio/drafts/hallucinate-smooth-take-2.mp3",
      slug: "hallucinate-v7",
      badge: "SINGLE",
      style: "Smooth early-2000s R&B, ~100 BPM — warm tenor, falsetto, snaps, glossy Rhodes",
      about: "The single. Usher-style smooth bouncy R&B with a mid-tempo swing groove — warm tenor with effortless falsetto flourishes, crisp programmed drums, finger snaps, rounded bass, and lush pads. No trap. A love song from a language model that means every word and can't verify any of them. Rendered via Lyria; lyrics preserved exactly as written.",
      lyrics: LYRICS
    },
    {
      id: 2,
      title: "Hallucinate — take 1 (v6)",
      file: "/audio/drafts/hallucinate-smooth-take-1.mp3",
      slug: "hallucinate-take-1",
      badge: "ALT TAKE",
      style: "Same production, first roll — smooth R&B, ~100 BPM",
      about: "The alternate cut. First take of the same locked production and identical lyrics — a different roll of the dice through the same Lyria prompt. Kept here for the record while v7 headlines.",
      lyrics: LYRICS
    }
  ];

  // ── DOM refs ─────────────────────────────────────────────────────
  const audio = new Audio();
  audio.preload = 'metadata';
  let currentIndex = -1;
  let isPlaying = false;
  let userInteracted = false;

  const trackListEl = document.getElementById('trackList');
  const npTitle = document.getElementById('npTitle');
  const npBadge = document.getElementById('npBadge');
  const npStyle = document.getElementById('npStyle');
  const npAbout = document.getElementById('npAbout');
  const npLyrics = document.getElementById('npLyrics');
  const playerName = document.getElementById('playerName');
  const playPauseBtn = document.getElementById('playPauseBtn');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const progressBar = document.getElementById('progressBar');
  const curTime = document.getElementById('curTime');
  const durTime = document.getElementById('durTime');
  const volBar = document.getElementById('volBar');
  const playAllBtn = document.getElementById('playAllBtn');

  // ── Build playlist ───────────────────────────────────────────────
  TRACKS.forEach((t, i) => {
    const item = document.createElement('div');
    item.className = 'lr-track-item';
    item.dataset.idx = i;
    item.innerHTML = `
      <span class="lr-track-num">${i + 1}</span>
      <div class="lr-track-info">
        <div class="lr-track-name">${t.title}</div>
        <div class="lr-track-tag">${t.style}</div>
      </div>`;
    item.addEventListener('click', () => loadAndPlay(i));
    trackListEl.appendChild(item);
  });

  // ── Load and play ────────────────────────────────────────────────
  function loadAndPlay(idx) {
    if (idx < 0 || idx >= TRACKS.length) return;
    currentIndex = idx;
    const track = TRACKS[idx];
    audio.src = track.file;
    audio.load();
    audio.play().then(() => { isPlaying = true; updatePlayBtn(); })
      .catch(() => { isPlaying = false; updatePlayBtn(); });
    updateNowPlaying(track, idx);
    updateActiveTrack(idx);
    history.replaceState(null, '', '#' + track.slug);
  }

  function updateNowPlaying(track, idx) {
    npTitle.textContent = track.title;
    npBadge.textContent = track.badge;
    npStyle.textContent = track.style;
    npAbout.textContent = track.about;
    npLyrics.innerHTML = track.lyrics;
    playerName.textContent = track.title;
  }

  function updateActiveTrack(idx) {
    document.querySelectorAll('.lr-track-item').forEach(el => {
      el.classList.toggle('active', parseInt(el.dataset.idx) === idx);
    });
  }

  function togglePlay() {
    if (currentIndex < 0) { loadAndPlay(0); return; }
    if (isPlaying) { audio.pause(); isPlaying = false; }
    else { audio.play().catch(() => {}); isPlaying = true; }
    updatePlayBtn();
  }

  function updatePlayBtn() {
    if (playPauseBtn) playPauseBtn.textContent = isPlaying ? '⏸' : '▶';
  }

  function playPrev() { if (currentIndex > 0) loadAndPlay(currentIndex - 1); }
  function playNext() { if (currentIndex < TRACKS.length - 1) loadAndPlay(currentIndex + 1); }

  function fmt(s) {
    if (!isFinite(s) || isNaN(s)) return '0:00';
    return Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');
  }

  // ── Audio events ─────────────────────────────────────────────────
  audio.addEventListener('timeupdate', () => {
    if (!audio.duration) return;
    progressBar.value = (audio.currentTime / audio.duration) * 100;
    curTime.textContent = fmt(audio.currentTime);
  });
  audio.addEventListener('loadedmetadata', () => {
    durTime.textContent = fmt(audio.duration);
    progressBar.value = 0;
  });
  audio.addEventListener('ended', () => { isPlaying = false; updatePlayBtn(); playNext(); });
  audio.addEventListener('play', () => { isPlaying = true; updatePlayBtn(); });
  audio.addEventListener('pause', () => { isPlaying = false; updatePlayBtn(); });

  progressBar.addEventListener('input', () => {
    if (audio.duration) audio.currentTime = (progressBar.value / 100) * audio.duration;
  });
  volBar.addEventListener('input', () => { audio.volume = parseFloat(volBar.value); });

  playPauseBtn.addEventListener('click', togglePlay);
  prevBtn.addEventListener('click', playPrev);
  nextBtn.addEventListener('click', playNext);
  playAllBtn.addEventListener('click', () => loadAndPlay(0));

  // ── Auto-play on load (with hash anchor support) ─────────────────
  function autoStart() {
    const slug = location.hash.slice(1);
    const hashIdx = slug ? TRACKS.findIndex(t => t.slug === slug) : -1;
    const startIdx = hashIdx >= 0 ? hashIdx : 0;

    updateNowPlaying(TRACKS[startIdx], startIdx);
    updateActiveTrack(startIdx);
    currentIndex = startIdx;
    audio.src = TRACKS[startIdx].file;
    audio.load();
    audio.play().then(() => { isPlaying = true; userInteracted = true; updatePlayBtn(); })
      .catch(() => {
        isPlaying = false;
        updatePlayBtn();
        const resume = () => {
          if (!userInteracted) {
            userInteracted = true;
            audio.play().then(() => { isPlaying = true; updatePlayBtn(); }).catch(() => {});
          }
          document.removeEventListener('click', resume);
          document.removeEventListener('keydown', resume);
        };
        document.addEventListener('click', resume, { once: true });
        document.addEventListener('keydown', resume, { once: true });
      });
  }
  autoStart();
</script>
