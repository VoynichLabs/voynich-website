  /* ── Layout ──────────────────────────────────────────────── */
  .lr-container {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: calc(100vh - 280px - 64px);
    background: #0c0c14;
  }
  @media (max-width: 768px) {
    .lr-container { grid-template-columns: 1fr; }
    .lr-playlist {
      position: static !important;
