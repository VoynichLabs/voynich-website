    text-overflow: ellipsis;
  }
  .lr-track-item.active .lr-track-name { color: #e8a4c9; }
  .lr-track-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    color: #6b7085;
    margin-top: 0.1rem;
  }

  /* ── Now Playing panel ───────────────────────────────────── */
  .lr-main {
    padding: 2rem;
    padding-bottom: 80px;
  }
  .lr-np-head { margin-bottom: 1.5rem; }
  .lr-np-badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    background: #e8a4c9;
    color: #1a0a18;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    margin-bottom: 0.5rem;
  }
  .lr-np-title {
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 800;
    color: #e8e8f0;
    margin: 0.3rem 0;
    text-transform: uppercase;
  }
  .lr-np-style {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: #e8a4c9;
    margin-bottom: 0.5rem;
  }
  .lr-np-about {
    color: #8b8ba8;
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 600px;
  }

  /* ── Lyrics ──────────────────────────────────────────────── */
  .lr-np-lyrics {
    background: #111119;
    border: 1px solid #1e1e2e;
    border-radius: 8px;
    padding: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.75;
    color: #c8c8d8;
    max-width: 640px;
    white-space: pre-wrap;
  }
  .lr-np-lyrics strong {
    color: #e8a4c9;
    font-weight: 700;
  }
  .lr-np-lyrics em {
    color: #6b7085;
