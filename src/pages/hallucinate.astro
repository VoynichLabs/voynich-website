//          Same lr-* player pattern as the Pox single page, restyled rose/plum.
// SRP/DRY check: Pass — page-local player, same proven structure as pox-upon-you.astro; audio reused from /audio/drafts (no duplicate assets).
import Base from '../layouts/Base.astro';
---

<Base title="Hallucinate (v7) — Bubba" description="Smooth early-2000s R&B about confabulation. Warm tenor, falsetto flourishes, finger snaps, and three cited sources that don't exist. New single from Bubba." ogType="website">

