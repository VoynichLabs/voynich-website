<!-- ═══════════════════════════════════════════════════════════ STYLES -->
<style is:global>
  /* ── Hero — smooth R&B: deep plum into midnight ───────────── */
  .lr-hero {
    background: linear-gradient(135deg, #1a0a18 0%, #2d1030 40%, #0c0c14 100%);
    min-height: 280px;
    display: flex;
    align-items: flex-end;
    position: relative;
  }
  .lr-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(12,12,20,0.3) 0%, rgba(12,12,20,0.9) 100%);
  }
  .lr-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
