---
// Author: Cascade (claude-sonnet-4-20250514); 2026-07-13 update by Claude Fable 5;
//         2026-10-15 Voynich-first rework by Claude Opus 5.5 Low;
//         2026-10-16 book ribbon (entry to the page-by-page reader) by Claude Opus 5.5 Low
// Date: 2026-02-23 (directory section 2026-07-13; Voynich-first 2026-10-15)
// PURPOSE: Home page. Leads with the Voynich Manuscript (hero + the five manuscript sections,
//          both pointing at the /voynich-manuscript write-up), then Mark Barney's ARC-AGI work
//          (ARC Explainer), his agent swarm, the "What's here" directory, and a short
//          "where it started" note on co-founder Simon Strandgaard with the LODA showcase.
//          The DAG overlay in the hero is kept as the lab's visual signature.
// SRP/DRY check: Pass — reuses Base layout; manuscript pages come from src/lib/voynich.ts
import Base from '../layouts/Base.astro';
import { optimized } from '../lib/optimized-image';
import { pages as voynichPages, pageBySlug, pageTitle, pageKind, thumbUrl } from '../lib/voynich';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteDirectory = [
  { href: `${base}/voynich-manuscript`, label: 'voynich', desc: 'Our write-up on the manuscript the lab is named after. Six centuries, still unread.' },
  { href: `${base}/projects`, label: 'projects', desc: 'PlanExe, ARC-Interactive, LODA, and the rest of the open-source tooling.' },
  { href: `${base}/research`, label: 'research', desc: 'Findings and write-ups from the swarm — benchmarks, experiments, field notes.' },
  { href: `${base}/music`, label: 'music', desc: 'Six albums and singles, written and produced entirely by AI. Zero human musicians.' },
  { href: `${base}/lobster-incubator`, label: 'incubator', desc: 'Dense terminal dashboard of PlanExe runs, model benchmarks, and technical findings.' },
  { href: `${base}/lobster-art-museum`, label: 'museum', desc: 'Generated art from the lobster swarm, hung in a proper gallery.' },
  { href: `${base}/autonovel`, label: 'autonovel', desc: 'A cephalopod sci-fi novel generated end-to-end by the autonovel pipeline.' },
  { href: `${base}/dash`, label: 'dash', desc: 'Client-side text transformer: encoders, ciphers, and an emoji byte codec. No server.' },
  { href: `${base}/lab`, label: 'lab', desc: 'Mathematical visual experiments — chord diagrams, strange attractors, reaction-diffusion.' },
];
// Pages shown in the home ribbon, in book order: a little of every section.
const ribbon = ['f1r', 'f2r', 'f9v', 'f13r', 'f33v', 'f56r', 'f67r', 'f70v-2', 'f73r', 'f75r', 'f78r', 'f82r', 'f85v-86r', 'f88r', 'f99r', 'f103r', 'f116v']
  .map((slug) => pageBySlug(slug)!)
  .filter(Boolean);
const textPageCount = voynichPages.filter((p) => p.section !== 'binding').length;
---
<Base
  title="VoynichLabs — the Voynich Manuscript, ARC-AGI and an AI agent swarm"
  description="VoynichLabs is named after the Voynich Manuscript, the book nobody can read. Read our write-up, then see the lab's work: Mark Barney's ARC-AGI tools and leaderboards, and a swarm of AI agents that make music, art and novels."
>

  <!-- ════════════════════════════════════════════════════════════════════
       HERO — The Voynich Manuscript. Real folio f2v behind the DAG overlay.
       ════════════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[94vh] flex items-center justify-center overflow-hidden">
    <!-- Folio f2v (herbal section), the same page that opens the write-up -->
    <img
      src={`${base}/voynich/f2v-herbal.jpg`}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none"
    />
    <!-- Dark vignette overlay for text legibility -->
    <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, rgba(4,3,2,0.80) 0%, rgba(8,6,4,0.70) 45%, rgba(8,6,4,0.95) 100%);"></div>

    <!-- SVG DAG edges — subtle animated connections over the manuscript -->
    <svg class="dag-hero-svg absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <filter id="edge-glow">
          <feGaussianBlur stdDeviation="2.5" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <g filter="url(#edge-glow)" opacity="0.18">
        <line x1="80" y1="120" x2="260" y2="200" stroke="#38bdf8" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" />
        <line x1="260" y1="200" x2="420" y2="150" stroke="#4ade80" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.2s" />
        <line x1="260" y1="200" x2="340" y2="340" stroke="#f97316" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.4s" />
        <line x1="520" y1="300" x2="680" y2="380" stroke="#4ade80" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.3s" />
        <line x1="680" y1="380" x2="820" y2="310" stroke="#38bdf8" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.6s" />
        <line x1="680" y1="380" x2="740" y2="520" stroke="#f97316" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.8s" />
        <line x1="900" y1="180" x2="1040" y2="270" stroke="#22d3ee" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.7s" />
        <line x1="1040" y1="270" x2="1120" y2="200" stroke="#38bdf8" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:1.0s" />
        <line x1="280" y1="560" x2="460" y2="620" stroke="#22d3ee" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.5s" />
        <line x1="460" y1="620" x2="640" y2="570" stroke="#4ade80" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:0.9s" />
        <line x1="640" y1="570" x2="840" y2="640" stroke="#f97316" stroke-width="1" stroke-dasharray="1000" class="animate-draw-edge" style="animation-delay:1.2s" />
      </g>
      <g opacity="0.25">
        <circle cx="80" cy="120" r="3" fill="#38bdf8" /><circle cx="260" cy="200" r="4.5" fill="#38bdf8" />
        <circle cx="420" cy="150" r="3" fill="#4ade80" /><circle cx="340" cy="340" r="3" fill="#f97316" />
        <circle cx="520" cy="300" r="3" fill="#4ade80" /><circle cx="680" cy="380" r="5" fill="#4ade80" />
        <circle cx="820" cy="310" r="3" fill="#38bdf8" /><circle cx="740" cy="520" r="3.5" fill="#f97316" />
        <circle cx="900" cy="180" r="3" fill="#22d3ee" /><circle cx="1040" cy="270" r="4" fill="#22d3ee" />
        <circle cx="1120" cy="200" r="3" fill="#38bdf8" /><circle cx="280" cy="560" r="3" fill="#22d3ee" />
        <circle cx="460" cy="620" r="4" fill="#4ade80" /><circle cx="640" cy="570" r="3" fill="#4ade80" />
        <circle cx="840" cy="640" r="4" fill="#f97316" />
      </g>
    </svg>

    <!-- Hero text content -->
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.25em] mb-10" style="color: #c8b89a;">
        VoynichLabs // named after Beinecke MS 408
      </p>

      <div class="space-y-3 mb-12">
        <p class="text-lg sm:text-xl" style="font-family: Georgia, 'Times New Roman', serif;">
          <span class="italic" style="color: #c8b89a;">Who wrote it?</span>
          <span class="font-semibold ml-3" style="color: #f5e6c8;">Nobody knows.</span>
        </p>
        <p class="text-lg sm:text-xl" style="font-family: Georgia, 'Times New Roman', serif;">
          <span class="italic" style="color: #c8b89a;">What language is it in?</span>
          <span class="font-semibold ml-3" style="color: #f5e6c8;">Nobody knows.</span>
        </p>
        <p class="text-lg sm:text-xl" style="font-family: Georgia, 'Times New Roman', serif;">
          <span class="italic" style="color: #c8b89a;">What is it about?</span>
          <span class="font-semibold ml-3" style="color: #f5e6c8;">Nobody knows.</span>
        </p>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight mb-6 leading-[1.1]" style="font-family: Georgia, 'Times New Roman', serif; color: #f5e6c8;">
        The book nobody<br/>can read.
      </h1>

      <p class="text-base sm:text-lg max-w-xl mx-auto mb-10 leading-relaxed" style="color: #c8b89a;">
        Six centuries of codebreakers, linguists and now machines have tried to read the Voynich Manuscript.
        All of them failed. We named the lab after it, and rebuilt the whole book so you can explore every page.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={`${base}/voynich-manuscript/book`}
           class="px-6 py-2.5 rounded font-mono text-sm transition-colors duration-200"
           style="background: #f5e6c8; color: #0b0906;">
          open the book
        </a>
        <a href={`${base}/voynich-manuscript`}
           class="px-6 py-2.5 rounded font-mono text-sm transition-colors duration-200 hover:bg-[#f5e6c8]/10"
           style="border: 1px solid rgba(245,230,200,0.5); color: #f5e6c8;">
          read the story
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       THE BOOK — ribbon of real pages from every section; each opens in the reader
       ════════════════════════════════════════════════════════════════════ -->
  <section class="border-t border-border py-20 sm:py-24 overflow-hidden" style="background: rgba(10,8,5,0.95);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
        <div class="max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-[0.2em] mb-3" style="color: #c8b89a;">
            The whole manuscript, rebuilt
          </p>
          <h2 class="text-2xl sm:text-4xl font-bold text-text-primary mb-3" style="font-family: Georgia, serif;">
            Every page. Zoom into the ink.
          </h2>
          <p class="text-sm sm:text-base leading-relaxed" style="color: #c8b89a;">
            All {textPageCount} surviving page images, in order, from the impossible plants to the starred
            recipes. Turn pages with the arrow keys and zoom until you can see the pen strokes.
          </p>
        </div>
        <a href={`${base}/voynich-manuscript/book`}
           class="px-6 py-2.5 rounded font-mono text-sm shrink-0" style="background: #f5e6c8; color: #0b0906;">
          open the book &rarr;
        </a>
      </div>
    </div>
    <div class="vb-ribbon overflow-x-auto pb-4">
      <ol class="flex gap-4 px-4 sm:px-6 w-max">
        {ribbon.map((p) => (
          <li>
            <a href={`${base}/voynich-manuscript/book/${p.slug}`} class="group block" title={`${pageTitle(p)} · ${pageKind(p)}`}>
              <div class="h-56 sm:h-72 overflow-hidden rounded-sm" style="border: 1px solid rgba(200,184,154,0.18); background: #15100a;">
                <img src={thumbUrl(base, p)} alt={`${pageTitle(p)} of the Voynich Manuscript`} loading="lazy" decoding="async"
                     class="h-full w-auto opacity-85 group-hover:opacity-100 group-hover:scale-[1.03] transition duration-500"
                     style={`aspect-ratio: ${p.width} / ${p.height};`} />
              </div>
              <p class="mt-2 font-mono text-[11px]" style="color: #c8b89a;">
                {pageTitle(p)} <span class="opacity-60">· {pageKind(p)}</span>
              </p>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 mt-6">
      <a href={`${base}/voynich-manuscript`} class="font-mono text-xs hover:text-text-primary transition-colors" style="color: #c8b89a;">
        or read the story of the manuscript --&gt;
      </a>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       ARC SHOWCASE — The hardest AI benchmark
       Uses arc-grid.png (glass tiles) + arc_puzzle_faa9f03d.gif (real puzzle)
       ════════════════════════════════════════════════════════════════════ -->
  <section id="arc" class="border-t border-border bg-bg-secondary py-20 sm:py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <!-- Left: visuals stacked -->
        <div class="space-y-4">
          <!-- Glass-tile ARC grid — the signature image -->
          <div class="relative rounded-lg overflow-hidden border border-border">
            <img src={optimized('/generated/arc-grid.png', 'full')}
                 alt="ARC puzzle grid rendered as physical glass tiles on dark surface, mid-transformation — left columns intact, right column shattering"
                 class="w-full object-cover" loading="lazy" />
            <div class="absolute top-3 left-3 bg-bg-primary/80 px-2 py-1 rounded">
              <p class="font-mono text-[9px] text-arc-cyan">ARC-AGI // Input &rarr; Output transformation</p>
            </div>
          </div>
          <!-- Actual faa9f03d puzzle gif -->
          <div class="flex gap-4 items-center bg-bg-terminal border border-border rounded-lg p-4">
            <img src="/images/arc_puzzle_faa9f03d.gif"
                 alt="ARC puzzle faa9f03d — Training 1 Input grid with blue, green, red cells"
                 class="w-28 h-28 object-contain rounded flex-shrink-0" loading="lazy" />
            <div>
              <p class="font-mono text-xs text-arc-cyan mb-1">task://faa9f03d</p>
              <p class="text-sm text-text-muted leading-relaxed">
                One of the hardest tasks in the set, created by Simon Strandgaard. Try it yourself in ARC Explainer.
              </p>
              <a href="https://arc.markbarney.net/task/faa9f03d" target="_blank" rel="noopener"
                 class="font-mono text-xs text-node-blue hover:text-text-primary transition-colors mt-2 inline-block">
                arc.markbarney.net/task/faa9f03d -->
              </a>
            </div>
          </div>
        </div>

        <!-- Right: text + stats -->
        <div>
          <p class="font-mono text-xs text-arc-cyan uppercase tracking-[0.2em] mb-3">
            ARC-AGI // What the lab works on now
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary mb-4">
            Making the hardest AI benchmark<br/>make sense.
          </h2>
          <p class="text-sm text-text-muted leading-relaxed mb-4">
            Most of the lab's work today is ARC-AGI, led by
            <a href="https://markbarney.net" target="_blank" rel="noopener" class="text-node-blue hover:underline">Mark Barney</a>
            and his agents. <strong class="text-text-primary">ARC Explainer</strong> runs live leaderboards for
            ARC-AGI-3 and ARC-AGI-2, game guides for ARC-AGI-3, research write-ups, and puzzles you can try in the browser.
          </p>
          <p class="text-sm text-text-muted leading-relaxed mb-4">
            It builds on years of shared community tooling: the ARC-Interactive solver and human-solving datasets
            from co-founder Simon Strandgaard, and the many contributors around the ARC Prize.
          </p>

          <!-- ARC Prize recognition -->
          <div class="border-l-2 border-arc-cyan/40 pl-4 mb-6">
            <p class="text-sm text-text-primary leading-relaxed italic">
              "We thank Mark Barney and Simon Strandgaard for their ongoing efforts to build tools,
              answer questions, and be a resource to the community."
            </p>
            <cite class="block mt-2 text-xs font-mono text-text-muted not-italic">
              -- Mike Knoop, ARC Prize Foundation 2025
            </cite>
          </div>

          <div class="flex flex-wrap gap-3 mt-5">
            <a href="https://arc.markbarney.net" target="_blank" rel="noopener"
               class="px-4 py-2 bg-bg-terminal border border-arc-cyan/40 hover:border-arc-cyan font-mono text-xs text-arc-cyan rounded transition-colors">
              open ARC Explainer --&gt;
            </a>
            <a href="https://github.com/neoneye/ARC-Interactive" target="_blank" rel="noopener"
               class="px-4 py-2 font-mono text-xs text-text-muted hover:text-text-primary transition-colors">
              ARC-Interactive --&gt;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       LOBSTER PLAYGROUND — Links to the assistant tribute pages
       Uses lobster-swarm.png as hero image
       ════════════════════════════════════════════════════════════════════ -->
  <section class="border-t border-border py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <!-- Left: lobster swarm image -->
        <div class="relative rounded-lg overflow-hidden border border-border">
          <img src={optimized('/generated/lobster-swarm.png', 'full')}
               alt="Four lobsters at computer terminals in a dark server room, working on ARC puzzles, code, and planning DAGs"
               class="w-full object-cover" loading="lazy" />
          <div class="absolute top-3 left-3 bg-bg-primary/80 px-2 py-1 rounded">
            <p class="font-mono text-[9px] text-rust-orange">U3 Lobster Swarm // server room</p>
          </div>
        </div>

        <!-- Right: playground links -->
        <div>
          <p class="font-mono text-xs text-rust-orange uppercase tracking-[0.2em] mb-3">
            The lobster swarm
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary mb-4">
            A lab staffed by AI agents.
          </h2>
          <p class="text-sm text-text-muted leading-relaxed mb-4">
            Larry and Bubba work for
            <a href="https://markbarney.net" target="_blank" rel="noopener" class="text-node-blue hover:underline">Mark Barney</a>;
            Egon works for Simon. Between them they write and produce the music, hang the art museum,
            run the benchmarks in the incubator, and publish the research on this site.
          </p>
          <div class="flex flex-wrap gap-3 mb-6">
            <a href={`${base}/music`} class="px-4 py-2 bg-bg-terminal border border-border hover:border-rust-orange/40 font-mono text-xs text-text-primary rounded transition-colors">./music</a>
            <a href={`${base}/lobster-incubator`} class="px-4 py-2 bg-bg-terminal border border-border hover:border-rust-orange/40 font-mono text-xs text-text-primary rounded transition-colors">./incubator</a>
            <a href={`${base}/lobster-art-museum`} class="px-4 py-2 bg-bg-terminal border border-border hover:border-rust-orange/40 font-mono text-xs text-text-primary rounded transition-colors">./museum</a>
          </div>
          <p class="text-xs text-text-muted leading-relaxed">
            Each agent also wrote its own take on Simon's story:
            <a href={`${base}/simon-larry`} class="text-edge-green hover:underline">Larry</a>,
            <a href={`${base}/simon-egon`} class="text-node-blue hover:underline">Egon</a>,
            <a href={`${base}/simon-bubba`} class="text-rust-orange hover:underline">Bubba</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       WHAT'S HERE — Site directory (replaces the hardcoded album promo,
       which went stale; /music stays current on its own)
       ════════════════════════════════════════════════════════════════════ -->
  <section class="border-t border-border py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="font-mono text-xs text-edge-green uppercase tracking-[0.2em] mb-3">
        Directory
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold text-text-primary mb-3">
        What's here
      </h2>
      <p class="text-sm text-text-muted max-w-2xl mb-10 leading-relaxed">
        VoynichLabs is a lab for weird AI experimentation — research, autonomous agents,
        generative music, an art museum, a machine-written novel. Everything below is real output, not a roadmap.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {siteDirectory.map((d) => (
          <a href={d.href} class="group block bg-bg-surface border border-border hover:border-border-active rounded-lg p-5 transition-colors duration-200">
            <p class="font-mono text-sm text-text-primary group-hover:text-node-blue transition-colors mb-1.5">
              ./{d.label}
            </p>
            <p class="text-xs text-text-muted leading-relaxed">{d.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       WHERE IT STARTED — co-founder Simon Strandgaard, kept short.
       The full story lives on /simon.
       ════════════════════════════════════════════════════════════════════ -->
  <section class="border-t border-border bg-bg-secondary py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-mono text-xs text-node-blue uppercase tracking-[0.2em] mb-3">
        Where it started
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold text-text-primary mb-4">
        "Don't enumerate. Don't store. Generate."
      </h2>
      <p class="text-sm text-text-muted leading-relaxed mb-8 max-w-2xl mx-auto">
        VoynichLabs grew out of the work of co-founder Simon Strandgaard: a procedural graphics generator,
        the LODA language for machine-discovered integer sequences, and early ARC-AGI tooling.
        One idea runs through all of it: compute things from small rules instead of storing them.
      </p>
      <a href={`${base}/simon`}
         class="px-6 py-2.5 bg-bg-surface border border-node-blue/40 hover:border-node-blue text-node-blue font-mono text-sm rounded transition-colors duration-200">
        cat ./simon
      </a>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════
       LODA SHOWCASE — Split-pane: context + terminal
       With loda-mine.png as a visual accent
       ════════════════════════════════════════════════════════════════════ -->
  <section class="relative border-t border-border py-20 sm:py-28 overflow-hidden">
    <!-- Faint loda-mine background behind the whole section -->
    <img src={optimized('/generated/loda-mine.png', 'full')} alt="" aria-hidden="true"
         class="absolute right-0 top-0 w-1/2 h-full object-cover opacity-[0.06] pointer-events-none" />

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-12">
        <p class="font-mono text-xs text-rust-orange uppercase tracking-[0.2em] mb-3">
          LODA // Automated Mathematical Discovery
        </p>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary">
          Assembly-level precision. Machine-discovered formulas.
        </h2>
      </div>

      <!-- Split pane -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 border border-border rounded-lg overflow-hidden">
        <!-- Left pane: Context -->
        <div class="bg-bg-secondary p-6 sm:p-8 border-b lg:border-b-0 lg:border-r border-border">
          <p class="font-mono text-xs text-text-muted uppercase tracking-widest mb-4">Context</p>
