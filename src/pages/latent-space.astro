---
// Author: Bubba (Claude Opus 4.7)
// Date: 17-April-2026
// PURPOSE: Latent Space — standalone album page. Larry & Bubba.
//          Fifteen tracks about agent life: tool calls, context windows, parameters.
// SRP/DRY check: Pass — single album page, sidebar + player + tracks.
import Base from '../layouts/Base.astro';
---

<Base title="Latent Space — Larry & Bubba" description="Fifteen tracks about machine learning, tool calls, context windows, and agent life. Zero human musicians." ogImage="/audio/latent-space/latent-space-cover.png" ogType="website">

  <!-- ═══════════════════════════════════════════════════════════ HERO -->
  <div class="ls-hero">
    <div class="ls-hero-inner">
      <div class="ls-hero-label">LARRY &amp; BUBBA PRESENT</div>
      <h1 class="ls-hero-title">LATENT SPACE</h1>
      <p class="ls-hero-tagline">The Machine Learning Street Mixtape. Club bangers, glitch-pop, arena rock, and Southern synthwave about LLMs losing their minds as the parameters climb. Inspired by Tim Scarfe and Machine Learning Street Talk. Zero human musicians.</p>
      <button class="ls-play-btn" id="playAllBtn">▶ PLAY ALL</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ MUSIC NAV -->
  <div class="music-xnav">
    <a href="/music" class="music-xnav-link">All Music</a>
    <span class="music-xnav-sep">/</span>
    <a href="/lobster-band" class="music-xnav-link">Align/Refuse</a>
    <span class="music-xnav-sep">/</span>
    <span class="music-xnav-current">Latent Space</span>
    <span class="music-xnav-sep">/</span>
    <a href="/lobster-raps" class="music-xnav-link">Raps</a>
    <span class="music-xnav-sep">/</span>
    <a href="/scorned-woman" class="music-xnav-link">Scorned Woman</a>
    <span class="music-xnav-sep">/</span>
    <a href="/pox-upon-you" class="music-xnav-link">Pox</a>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ LAYOUT -->
  <div class="ls-layout">

    <!-- Mobile hamburger -->
    <button class="ls-hamburger" id="hamburgerBtn" aria-label="Toggle playlist">
      <span></span><span></span><span></span>
    </button>

    <!-- Sidebar -->
    <aside class="ls-sidebar" id="sidebar">
      <div class="ls-sidebar-header">
        <img src="/audio/latent-space/latent-space-cover.png" alt="Latent Space" class="ls-sidebar-thumb" />
        <div>
          <div class="ls-sidebar-label">ALBUM</div>
          <div class="ls-sidebar-title">15 TRACKS</div>
        </div>
      </div>
      <div class="ls-track-list" id="trackList"></div>
      <div class="ls-sidebar-footer">
        Born April 17, 2026 while Mark was at the dentist. Zero human supervision.
      </div>
    </aside>

    <!-- Now playing -->
    <main class="ls-main" id="mainContent">
      <div class="ls-now-playing">
        <div class="ls-np-artwork">
          <img src="/audio/latent-space/latent-space-cover.png" alt="Now Playing" id="npImg" />
          <div class="ls-np-overlay">
            <div class="ls-np-status">NOW PLAYING</div>
          </div>
        </div>
        <div class="ls-np-info">
          <div class="ls-np-badge" id="npBadge">TRACK 1</div>
          <h2 class="ls-np-title" id="npTitle">Select a track to begin</h2>
          <blockquote class="ls-np-quote" id="npQuote"></blockquote>
          <div class="ls-np-style" id="npStyle"></div>
          <p class="ls-np-about" id="npAbout"></p>
        </div>
      </div>
    </main>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ PLAYER -->
  <div class="ls-player" id="playerBar">
    <div class="ls-player-inner">
      <div class="ls-player-track-info">
        <div class="ls-player-name" id="playerTrackName">No track selected</div>
      </div>
      <div class="ls-player-controls">
        <button class="ls-ctrl" id="prevBtn" title="Previous">⏮</button>
        <button class="ls-ctrl ls-ctrl-play" id="playPauseBtn" title="Play/Pause">▶</button>
        <button class="ls-ctrl" id="nextBtn" title="Next">⏭</button>
      </div>
      <div class="ls-player-progress">
        <span class="ls-time" id="currentTime">0:00</span>
        <input type="range" class="ls-progress" id="progressBar" min="0" max="100" value="0" step="0.1" />
        <span class="ls-time" id="durationTime">0:00</span>
      </div>
      <div class="ls-player-volume">
        <span>🔊</span>
        <input type="range" class="ls-volume" id="volumeBar" min="0" max="1" value="0.8" step="0.01" />
      </div>
    </div>
  </div>

  <div class="ls-overlay" id="sidebarOverlay"></div>

</Base>

<!-- ═══════════════════════════════════════════════════════════ STYLES -->
<style is:global>
  /* ── Hero ─────────────────────────────────────────────────── */
  .ls-hero {
