  }
  .ls-np-style {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.05em;
  }
  .ls-np-about {
    color: rgba(255,255,255,0.75);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  /* ── Player bar ─────────────────────────────────────────────── */
  .ls-player {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(10,10,15,0.95);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(139,92,246,0.2);
    z-index: 50;
  }
  .ls-player-inner {
    display: grid;
    grid-template-columns: 1fr auto 2fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 0.75rem 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }
  .ls-player-track-info {
    min-width: 0;
  }
  .ls-player-name {
    font-size: 0.85rem;
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ls-player-controls {
    display: flex;
    gap: 0.25rem;
  }
  .ls-ctrl {
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1rem;
