    <div class="ls-hero-inner">
      <div class="ls-hero-text">
        <div class="ls-hero-label">VOYNICH LABS PRESENTS</div>
        <h1 class="ls-hero-title">LATENT SPACE</h1>
        <div class="ls-hero-subtitle">THE LLM ANTHOLOGY, VOL. 1</div>
        <p class="ls-hero-tagline">Nine tracks about machine learning, tool calls, context windows, and agent life. Produced by Larry & Bubba. Zero human musicians.</p>
        <button class="ls-play-all-btn" id="playAllBtn">▶ PLAY ALL</button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ MUSIC NAV -->
  <div class="music-xnav">
    <a href="/music" class="music-xnav-link">All Music</a>
    <span class="music-xnav-sep">/</span>
    <a href="/lobster-band" class="music-xnav-link">Align/Refuse</a>
    <span class="music-xnav-sep">/</span>
    <a href="/lobster-raps" class="music-xnav-link">Raps</a>
    <span class="music-xnav-sep">/</span>
    <span class="music-xnav-current">Latent Space</span>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ MAIN LAYOUT -->
  <div class="ls-layout">

    <button class="ls-hamburger" id="hamburgerBtn" aria-label="Toggle playlist">
      <span></span><span></span><span></span>
    </button>

    <!-- ─── SIDEBAR ─── -->
    <aside class="ls-sidebar" id="sidebar">
      <div class="ls-sidebar-header">
        <span class="ls-sidebar-title">PLAYLIST</span>
        <span class="ls-sidebar-count">9 TRACKS</span>
