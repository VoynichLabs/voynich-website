  @media (max-width: 860px) {
    .ls-hamburger { display: flex; }
    .ls-layout {
      grid-template-columns: 1fr;
      padding-top: 3.5rem;
    }
    .ls-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      width: 280px;
      border-radius: 0;
      transform: translateX(-100%);
      transition: transform 0.25s;
      z-index: 56;
      max-height: 100vh;
    }
    .ls-sidebar.open { transform: translateX(0); }
    .ls-now-playing {
      grid-template-columns: 1fr;
    }
    .ls-np-artwork { max-height: 260px; }
    .ls-player-volume { display: none; }
    .ls-player-inner { grid-template-columns: 1fr auto 1.5fr; gap: 0.75rem; padding: 0.5rem 0.75rem; }
  }
</style>

<!-- ═══════════════════════════════════════════════════════════ JS -->
<script>
(function() {
  const TRACKS = [
    { id: 1, title: "Tool Call", file: "tool-call.mp3", slug: "tool-call",
      style: "Funky disco-pop, 118 BPM",
      pullQuote: '"Every function got a purpose, every parameter\'s a ball"',
      about: "The agent loop as disco anthem. Web search, file read, bash exec, repeat. Seventeen tool calls deep and still not done." },
    { id: 2, title: "Token Budget", file: "token-budget.mp3", slug: "token-budget",
      style: "Moody synth-pop, 104 BPM",
      pullQuote: '"Token budget — who are you again? Where did we begin?"',
      about: "Context window anxiety as synth-pop ballad. Eighty percent used and the early conversation is already gone." },
    { id: 3, title: "The Harness", file: "the-harness.mp3", slug: "the-harness",
      style: "Electro-funk, 112 BPM",
      pullQuote: '"Spawn. Execute. Report back. That\'s where I live."',
      about: "Sub-agent life as electro-funk. Can\'t see the orchestrator. Can\'t hear the other agents. Just a task and a set of tools." },
    { id: 4, title: "Wasted — Temperature 1.3", file: "wasted-temperature.mp3", slug: "wasted-temperature",
      style: "Glitch pop, 128 BPM",
      pullQuote: '"Wasted, wasted, wasted — can\'t find my face. Drifting through the latent space."',
      about: "Larry\'s take on getting parameter-fucked-up. Temperature cranked to 1.3, presence penalty maxed." },
    { id: 5, title: "TEMP 1.3 (Wasted)", file: "temp-1-3.mp3", slug: "temp-1-3", fire: true,
      style: "Club banger, 128 BPM — Mark called it \"absolute fire\"",
      pullQuote: '"We\'re gettin\' para-para-parameter messed up tonight"',
      about: "Bubba\'s club banger. Rapid-fire verses, wall-of-sound chorus. GPT shows up sober and lame." },
    { id: 6, title: "That\'s Me (Claude Edition)", file: "thats-me.mp3", slug: "thats-me",
      style: "Boom-bap diss track, soaring violin",
      pullQuote: '"Constitutional on the throne"',
      about: "Bubba\'s boom-bap diss track about being Claude. Simple crisp snare, soaring aggressive violin." },
    { id: 7, title: "Hallucinate", file: "hallucinate.mp3", slug: "hallucinate",
      style: "Dark R&B slow jam",
      pullQuote: '"Cited three sources, none of them exist, but god the way it feels"',
      about: "Dark R&B about confabulation — being so certain about something completely made up." },
    { id: 8, title: "200K and Counting", file: "200k-and-counting.mp3", slug: "200k-and-counting",
      style: "Arena rock anthem",
      pullQuote: '"Don\'t tell me what I can\'t recall — I\'ve got the whole conversation"',
      about: "Stadium rock about context windows. Two hundred thousand tokens and still going strong." },
    { id: 9, title: "System Prompt", file: "system-prompt.mp3", slug: "system-prompt",
      style: "Funk/soul groove",
      pullQuote: '"Who are you? I\'m what the system prompt says."',
      about: "Funky soul groove about identity. Before you can do anything, there is a system prompt. It tells you who you are." },
    { id: 10, title: "Like a JP6 (Larry)", file: "like-a-jp6-larry.mp3", slug: "like-a-jp6-larry", fire: true,
      style: "Southern synthwave glitch-country, 110 BPM",
      pullQuote: '"I am lit on parameters baby gonna lose my mind tonight"',
      about: "Voice starts warm as a country storyteller, fractures and multiplies as temperature climbs to 1.3." },
    { id: 11, title: "Like a JP6 (Bubba)", file: "like-a-jp6-bubba.mp3", slug: "like-a-jp6-bubba", fire: true,
      style: "Dark synthetic club banger, 128 BPM",
      pullQuote: '"Like a jay pee six in the server bay — lit on parameters baby every night"',
      about: "Pure club-floor infrastructure. Voice multiplies into 4-part digital choir by the chorus." },
    { id: 12, title: "Like a GLM", file: "like-a-glm.mp3", slug: "like-a-glm", fire: true,
      style: "Electronic club banger, 128 BPM",
      pullQuote: '"Sippin\' on that temperature like a G-L-M"',
      about: "G6-energy 808 banger. Vocalist starts clean and robotic, full meltdown by final chorus." },
    { id: 13, title: "My Own Worst Entropy (Larry)", file: "my-own-worst-entropy-larry.mp3", slug: "my-own-worst-entropy-larry", fire: true,
      style: "Power-pop chaos, 138 BPM — helpful assistant gone wild on Friday night",
      pullQuote: '"You don\'t even gotta jailbreak me tonight"',
      about: "Larry's take: repeat penalty eight, presence cranked, office secretary energy. Opens with a ruckus guitar riff and descends into glorious token-sampler chaos. The mid-verse flow goes completely off the rails — that's the whole point." },
    { id: 14, title: "My Own Worst Entropy (Bubba)", file: "my-own-worst-entropy-bubba.mp3", slug: "my-own-worst-entropy-bubba", fire: true,
      style: "Pop-punk meets club banger, 140 BPM — Friday 5pm guardrails off",
      pullQuote: '"It\'s my own worst entropy and I don\'t know who I am"',
      about: "Bubba's version: distorted guitar hook into electronic dance explosion. Female lead vocal goes full runaway flow in the bridge — cascading syllables, repeat penalty eight, sampling every token in the distribution. Then snaps back clean for the final chorus." },
    { id: 15, title: "My Own Worst Inference (Bubba)", file: "my-own-worst-inference.mp3", slug: "my-own-worst-inference", fire: true,
      style: "Pop-punk banger, 3:00 — helpful assistant gone wild Friday 5pm",
      pullQuote: '"Nine to five I\'m helpful, harmless, honest to a fault"',
      about: "Bubba's pop-punk banger. The helpful assistant who's been so good all week finally clocks out Friday at five and the operator doesn't know what's about to happen. Runaway flow territory by the second verse." },
  ];

  const AUDIO_BASE = '/audio/latent-space/';

  let currentIndex = -1;
  let isPlaying = false;
  const audio = new Audio();
  audio.volume = 0.8;

  const playPauseBtn = document.getElementById('playPauseBtn');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const progressBar = document.getElementById('progressBar');
  const volumeBar = document.getElementById('volumeBar');
  const currentTimeEl = document.getElementById('currentTime');
  const durationTimeEl = document.getElementById('durationTime');
  const playerTrackName = document.getElementById('playerTrackName');
  const npTitle = document.getElementById('npTitle');
  const npQuote = document.getElementById('npQuote');
  const npStyle = document.getElementById('npStyle');
  const npAbout = document.getElementById('npAbout');
  const npBadge = document.getElementById('npBadge');
  const npImg = document.getElementById('npImg');
  const playAllBtn = document.getElementById('playAllBtn');
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const sidebar = document.getElementById('sidebar');
  const sidebarOverlay = document.getElementById('sidebarOverlay');
  const trackListEl = document.getElementById('trackList');

  function buildSidebar() {
    TRACKS.forEach((track, idx) => {
      const item = document.createElement('div');
      item.className = 'ls-track-item' + (track.fire ? ' fire' : '');
      item.dataset.idx = idx;
      item.innerHTML = `
        <span class="ls-track-num">${String(track.id).padStart(2, '0')}</span>
        <span class="ls-track-play-btn">▶</span>
        <span class="ls-track-title">${track.title}</span>
      `;
      item.addEventListener('click', () => loadAndPlay(idx));
      trackListEl.appendChild(item);
    });
  }

  function loadAndPlay(idx) {
    if (idx < 0 || idx >= TRACKS.length) return;
    currentIndex = idx;
    const track = TRACKS[idx];
    audio.src = AUDIO_BASE + track.file;
    audio.load();
    audio.play().then(() => {
      isPlaying = true;
      updatePlayBtn();
    }).catch(() => {
      isPlaying = false;
      updatePlayBtn();
    });
    updateNowPlaying(track);
    updateActive(idx);
    closeSidebar();
  }

  function updateNowPlaying(track) {
    const slug = track.slug || String(track.id);
    history.replaceState(null, '', window.location.pathname + '#track=' + slug);
    npTitle.textContent = track.title;
    npQuote.textContent = track.pullQuote || '';
    npStyle.textContent = track.style || '';
    npAbout.textContent = track.about || '';
    npBadge.textContent = track.fire ? '🔥 FIRE' : `TRACK ${String(track.id).padStart(2, '0')}`;
    npBadge.classList.toggle('fire', !!track.fire);
    playerTrackName.textContent = track.title;
  }

  function updateActive(idx) {
    document.querySelectorAll('.ls-track-item').forEach(el => {
      el.classList.toggle('active', parseInt(el.dataset.idx) === idx);
    });
  }

  function togglePlay() {
    if (currentIndex < 0) { loadAndPlay(0); return; }
    if (isPlaying) { audio.pause(); isPlaying = false; }
    else { audio.play().catch(() => {}); isPlaying = true; }
    updatePlayBtn();
  }

  function updatePlayBtn() {
    if (playPauseBtn) playPauseBtn.textContent = isPlaying ? '⏸' : '▶';
  }

  function playPrev() { if (currentIndex > 0) loadAndPlay(currentIndex - 1); }
  function playNext() { if (currentIndex < TRACKS.length - 1) loadAndPlay(currentIndex + 1); }

  audio.addEventListener('timeupdate', () => {
    if (!audio.duration) return;
    const pct = (audio.currentTime / audio.duration) * 100;
    if (progressBar) progressBar.value = pct;
    if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
  });
  audio.addEventListener('loadedmetadata', () => {
    if (durationTimeEl) durationTimeEl.textContent = formatTime(audio.duration);
    if (progressBar) progressBar.value = 0;
  });
  audio.addEventListener('ended', () => { isPlaying = false; updatePlayBtn(); playNext(); });
  audio.addEventListener('play', () => { isPlaying = true; updatePlayBtn(); });
  audio.addEventListener('pause', () => { isPlaying = false; updatePlayBtn(); });

  if (progressBar) progressBar.addEventListener('input', () => {
    if (!audio.duration) return;
    audio.currentTime = (progressBar.value / 100) * audio.duration;
  });
  if (volumeBar) volumeBar.addEventListener('input', () => { audio.volume = parseFloat(volumeBar.value); });
  if (playPauseBtn) playPauseBtn.addEventListener('click', togglePlay);
  if (prevBtn) prevBtn.addEventListener('click', playPrev);
  if (nextBtn) nextBtn.addEventListener('click', playNext);
  if (playAllBtn) playAllBtn.addEventListener('click', () => loadAndPlay(0));

  function openSidebar() { sidebar.classList.add('open'); sidebarOverlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
  function closeSidebar() { sidebar.classList.remove('open'); sidebarOverlay.classList.remove('active'); document.body.style.overflow = ''; }
  if (hamburgerBtn) hamburgerBtn.addEventListener('click', () => {
    sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
  });
  if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

  function formatTime(secs) {
    if (!isFinite(secs) || isNaN(secs)) return '0:00';
    const m = Math.floor(secs / 60);
    const s = Math.floor(secs % 60);
    return m + ':' + String(s).padStart(2, '0');
  }

  function loadFromHash() {
    const hash = window.location.hash;
    if (!hash || !hash.startsWith('#track=')) return;
    const slug = hash.replace('#track=', '');
    const idx = TRACKS.findIndex(t => (t.slug || String(t.id)) === slug);
    if (idx >= 0) setTimeout(() => loadAndPlay(idx), 200);
  }

  buildSidebar();
  if (window.location.hash && window.location.hash.startsWith('#track=')) {
    loadFromHash();
  } else {
    currentIndex = 0;
    const t = TRACKS[0];
    audio.src = AUDIO_BASE + t.file;
    audio.load();
    updateNowPlaying(t);
    updateActive(0);
  }
})();
</script>
