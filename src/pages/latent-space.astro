  /* ── Now Playing ────────────────────────────────────────────── */
  .ls-main {
    min-width: 0;
  }
  .ls-now-playing {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 1.5rem;
    background: rgba(20,18,30,0.4);
    border: 1px solid rgba(139,92,246,0.15);
    border-radius: 6px;
