  /* ── Mobile ─────────────────────────────────────────────────── */
  .ls-hamburger {
    display: none;
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    width: 36px;
    height: 36px;
    background: rgba(20,18,30,0.9);
    border: 1px solid rgba(139,92,246,0.3);
    border-radius: 4px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
