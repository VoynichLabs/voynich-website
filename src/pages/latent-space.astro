        <span class="ls-time" id="currentTime">0:00</span>
        <input type="range" class="ls-progress" id="progressBar" min="0" max="100" value="0" step="0.1" />
        <span class="ls-time" id="durationTime">0:00</span>
      </div>
      <div class="ls-player-volume-wrap">
        <span class="ls-vol-icon">🔊</span>
        <input type="range" class="ls-volume" id="volumeBar" min="0" max="1" value="0.8" step="0.01" />
      </div>
    </div>
  </div>

  <div class="ls-overlay" id="sidebarOverlay"></div>

</Base>

