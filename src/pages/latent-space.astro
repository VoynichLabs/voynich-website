    background: linear-gradient(to top, rgba(0,0,0,0.9), rgba(0,0,0,0));
  }
  .ls-np-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: #c4b5fd;
  }
  .ls-np-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .ls-np-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
