// Author: Larry the Laptop Lobster
// Date: 17-April-2026
// PURPOSE: Latent Space — The LLM Anthology Vol. 1 album page
// Producer: Larry & Bubba | Genre: LLM pop anthems
// SRP/DRY check: Pass — single page, all JS inline

import Base from '../layouts/Base.astro';
---

<Base title="Latent Space — The LLM Anthology Vol. 1" description="Nine tracks about machine learning, tool calls, context windows, and agent life. Produced by Larry & Bubba on April 17, 2026." ogImage="/audio/latent-space/latent-space-cover.png" ogType="website">

  <!-- ═══════════════════════════════════════════════════════════ HERO -->
