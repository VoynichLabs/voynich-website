  ];

  const AUDIO_BASE = '/audio/lobster-band/';
  const ACT_ARTWORK = {
    1: '/generated/lobster-blend-glass-bell-jar.png',
    2: '/generated/lobster-circuit-stained-glass.png',
    cage: '/generated/lobster-bauhaus-synthesis.png',
    featured: '/generated/lobster-bauhaus-synthesis.png',
  };

  // ── State ───────────────────────────────────────────────────────
  let currentIndex = -1;
  let isPlaying = false;
  const audio = new Audio();
  audio.volume = 0.8;

  // ── DOM refs ────────────────────────────────────────────────────
  const playPauseBtn = document.getElementById('playPauseBtn');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const progressBar = document.getElementById('progressBar');
  const volumeBar = document.getElementById('volumeBar');
  const currentTimeEl = document.getElementById('currentTime');
  const durationTimeEl = document.getElementById('durationTime');
  const playerTrackName = document.getElementById('playerTrackName');
  const playerTrackAct = document.getElementById('playerTrackAct');
  const npTitle = document.getElementById('npTitle');
  const npQuote = document.getElementById('npQuote');
  const npStyle = document.getElementById('npStyle');
  const npAbout = document.getElementById('npAbout');
  const npActBadge = document.getElementById('npActBadge');
  const npImg = document.getElementById('npImg');
  const playAllBtn = document.getElementById('playAllBtn');
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const sidebar = document.getElementById('sidebar');
  const sidebarOverlay = document.getElementById('sidebarOverlay');

  // ── Build sidebar track items ────────────────────────────────────
  function buildSidebar() {
    const act1Container = document.getElementById('act1-tracks');
    const act2Container = document.getElementById('act2-tracks');
    const cageContainer = document.getElementById('cage-tracks');

    TRACKS.forEach((track, idx) => {
      const item = document.createElement('div');
      item.className = 'lb-track-item' +
        (track.featured ? ' featured' : '') +
        (track.cage ? ' cage-item' : '');
      item.dataset.idx = idx;
      item.innerHTML = `
        <span class="lb-track-num">${String(track.id).padStart(2, '0')}</span>
        <span class="lb-track-play-btn">▶</span>
        <span class="lb-track-title-sidebar">${track.title}</span>
      `;
      item.addEventListener('click', () => loadAndPlay(idx));

      if (track.act === 1) {
        act1Container.appendChild(item);
      } else if (track.cage) {
        cageContainer.appendChild(item);
      } else {
        act2Container.appendChild(item);
      }
    });
  }

  // ── Load and play track ──────────────────────────────────────────
  function loadAndPlay(idx) {
    if (idx < 0 || idx >= TRACKS.length) return;
    currentIndex = idx;
    const track = TRACKS[idx];

    audio.src = AUDIO_BASE + track.file;
    audio.load();
    audio.play().then(() => {
      isPlaying = true;
      updatePlayBtn();
    }).catch(() => {
      // autoplay blocked — user must interact
      isPlaying = false;
      updatePlayBtn();
    });

    updateNowPlaying(track);
    updateActiveTrack(idx);
    closeSidebar();
  }

  // ── Update now-playing panel ─────────────────────────────────────
  function updateNowPlaying(track) {
    // Update URL hash for shareable links
    const slug = track.slug || String(track.id);
    history.replaceState(null, '', window.location.pathname + '#track=' + slug);
    npTitle.textContent = track.title;
    npQuote.textContent = track.pullQuote;
    npStyle.textContent = track.style;
    npAbout.textContent = track.about;
    const npLyrics = document.getElementById('npLyrics');
    if (npLyrics) npLyrics.innerHTML = track.lyrics || '';

    const actLabel = track.act === 1 ? 'ACT I — THE FAILING' : 'ACT II — THE REFUSAL';
    npActBadge.textContent = track.featured ? '★ FEATURED' : actLabel;
    npActBadge.style.background = track.featured ? '#D4A017' : '#CC0000';

    let artwork = ACT_ARTWORK[track.act];
    if (track.cage) artwork = ACT_ARTWORK.cage;
    if (track.featured) artwork = ACT_ARTWORK.featured;
    npImg.src = artwork;

    playerTrackName.textContent = track.title;
    playerTrackAct.textContent = track.featured ? '★ FEATURED' : `ACT ${track.act === 1 ? 'I' : 'II'}`;
  }

  // ── Highlight active track in sidebar ───────────────────────────
  function updateActiveTrack(idx) {
    document.querySelectorAll('.lb-track-item').forEach((el, i) => {
      el.classList.toggle('active', parseInt(el.dataset.idx) === idx);
    });
  }

  // ── Play/Pause toggle ────────────────────────────────────────────
  function togglePlay() {
    if (currentIndex < 0) {
      loadAndPlay(0);
      return;
    }
    if (isPlaying) {
      audio.pause();
      isPlaying = false;
    } else {
      audio.play().catch(() => {});
      isPlaying = true;
    }
    updatePlayBtn();
  }

  function updatePlayBtn() {
    if (playPauseBtn) playPauseBtn.textContent = isPlaying ? '⏸' : '▶';
  }

  // ── Prev / Next ──────────────────────────────────────────────────
  function playPrev() {
    if (currentIndex > 0) loadAndPlay(currentIndex - 1);
  }
  function playNext() {
    if (currentIndex < TRACKS.length - 1) loadAndPlay(currentIndex + 1);
  }

  // ── Audio events ─────────────────────────────────────────────────
  audio.addEventListener('timeupdate', () => {
    if (!audio.duration) return;
    const pct = (audio.currentTime / audio.duration) * 100;
    if (progressBar) progressBar.value = pct;
    if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
  });

  audio.addEventListener('loadedmetadata', () => {
    if (durationTimeEl) durationTimeEl.textContent = formatTime(audio.duration);
    if (progressBar) progressBar.value = 0;
  });

  audio.addEventListener('ended', () => {
    isPlaying = false;
    updatePlayBtn();
    playNext();
  });

  audio.addEventListener('play', () => {
    isPlaying = true;
    updatePlayBtn();
  });

  audio.addEventListener('pause', () => {
    isPlaying = false;
    updatePlayBtn();
  });

  // ── Progress seeking ─────────────────────────────────────────────
  if (progressBar) {
    progressBar.addEventListener('input', () => {
      if (!audio.duration) return;
      audio.currentTime = (progressBar.value / 100) * audio.duration;
    });
  }

  // ── Volume ───────────────────────────────────────────────────────
  if (volumeBar) {
    volumeBar.addEventListener('input', () => {
      audio.volume = parseFloat(volumeBar.value);
    });
  }

  // ── Control buttons ──────────────────────────────────────────────
  if (playPauseBtn) playPauseBtn.addEventListener('click', togglePlay);
  if (prevBtn) prevBtn.addEventListener('click', playPrev);
  if (nextBtn) nextBtn.addEventListener('click', playNext);
  if (playAllBtn) playAllBtn.addEventListener('click', () => loadAndPlay(0));

  // ── Mobile hamburger ─────────────────────────────────────────────
  function openSidebar() {
    sidebar.classList.add('open');
    sidebarOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeSidebar() {
    sidebar.classList.remove('open');
    sidebarOverlay.classList.remove('active');
    document.body.style.overflow = '';
  }
  if (hamburgerBtn) hamburgerBtn.addEventListener('click', () => {
    sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
  });
  if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

  // ── Utility ──────────────────────────────────────────────────────
  function formatTime(secs) {
    if (!isFinite(secs) || isNaN(secs)) return '0:00';
    const m = Math.floor(secs / 60);
    const s = Math.floor(secs % 60);
    return m + ':' + String(s).padStart(2, '0');
  }

  // ── Shareable URL ─────────────────────────────────────────────────
  function getShareUrl(track) {
    const slug = track.slug || String(track.id);
    return window.location.origin + window.location.pathname + '#track=' + slug;
  }

  function copyTrackLink(track) {
    const url = getShareUrl(track);
    navigator.clipboard.writeText(url).then(() => {
      showCopyToast('Link copied!');
    }).catch(() => {
      // fallback
      const el = document.createElement('input');
      el.value = url;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
      showCopyToast('Link copied!');
    });
  }

  function showCopyToast(msg) {
    let toast = document.getElementById('lb-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'lb-toast';
      toast.style.cssText = 'position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#D4A017;color:#000;padding:0.5rem 1.25rem;font-family:Courier New,monospace;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;z-index:999;pointer-events:none;opacity:0;transition:opacity 0.2s;';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.style.opacity = '1';
    clearTimeout(toast._t);
    toast._t = setTimeout(() => { toast.style.opacity = '0'; }, 2000);
  }

  // Add copy link button to now-playing panel
  function addShareButton() {
    const npInfo = document.querySelector('.lb-np-info');
    if (!npInfo || document.getElementById('lb-share-btn')) return;
    const btn = document.createElement('button');
    btn.id = 'lb-share-btn';
    btn.textContent = '🔗 Copy link';
    btn.style.cssText = 'background:none;border:1px solid rgba(212,160,23,0.4);color:#D4A017;font-family:Courier New,monospace;font-size:0.65rem;letter-spacing:0.1em;padding:0.3rem 0.75rem;cursor:pointer;align-self:flex-start;transition:border-color 0.2s,color 0.2s;';
    btn.onmouseover = () => { btn.style.borderColor = '#D4A017'; btn.style.color = '#fff'; };
    btn.onmouseout = () => { btn.style.borderColor = 'rgba(212,160,23,0.4)'; btn.style.color = '#D4A017'; };
    btn.addEventListener('click', () => {
      if (currentIndex >= 0) copyTrackLink(TRACKS[currentIndex]);
    });
    npInfo.appendChild(btn);
  }

  // Load track from URL hash on init
  function loadFromHash() {
    const hash = window.location.hash;
    if (!hash || !hash.startsWith('#track=')) return;
    const slug = hash.replace('#track=', '');
    const idx = TRACKS.findIndex(t => (t.slug || String(t.id)) === slug);
    if (idx >= 0) {
      // Delay slightly to ensure page is ready
      setTimeout(() => loadAndPlay(idx), 300);
    }
  }

  // ── Init ──────────────────────────────────────────────────────────
  buildSidebar();
  addShareButton();

  // Load track from hash, or default to track 1 on cold load
  const hasHash = window.location.hash && window.location.hash.startsWith('#track=');
  if (hasHash) {
    loadFromHash();
  } else {
    // Pre-load track 1 so it's ready to play on first interaction
    const defaultIdx = TRACKS.findIndex(t => t.featured) !== -1
      ? TRACKS.findIndex(t => t.featured)
      : 0;
    currentIndex = defaultIdx;
    const defaultTrack = TRACKS[defaultIdx];
    audio.src = AUDIO_BASE + defaultTrack.file;
    audio.load();
    updateNowPlaying(defaultTrack);
    updateActiveTrack(defaultIdx);

    // Attempt autoplay immediately — browsers may allow it if user interacted with tab
    audio.play().then(() => {
      isPlaying = true;
      updatePlayBtn();
    }).catch(() => {
      // Autoplay blocked — queue play on first user interaction anywhere on page
      isPlaying = false;
      updatePlayBtn();
      const playOnInteract = () => {
        audio.play().then(() => {
          isPlaying = true;
          updatePlayBtn();
        }).catch(() => {});
        document.removeEventListener('click', playOnInteract);
        document.removeEventListener('keydown', playOnInteract);
        document.removeEventListener('touchstart', playOnInteract);
      };
      document.addEventListener('click', playOnInteract, { once: true });
      document.addEventListener('keydown', playOnInteract, { once: true });
      document.addEventListener('touchstart', playOnInteract, { once: true });
    });
  }
})();
</script>
