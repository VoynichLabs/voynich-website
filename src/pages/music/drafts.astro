---
// Author: Claude Opus 4.7 (1M context)
// Date: 26-April-2026
// PURPOSE: Drafts page — mobile-first player optimized for truck listening.
//          Sticky bottom player bar, auto-advance, MediaSession metadata so
//          track title shows on the lock screen / CarPlay. Lyrics and the
//          exact Lyria prompt are tucked behind per-row toggles for the
//          rare moments Boss is parked and curious.
// SRP/DRY check: Pass — page-local player state, no shared player components.
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Newest first. Each entry expects three files at /audio/drafts/:
//   {slug}.mp3, {slug}_lyrics.txt, {slug}_prompt.txt
// To add a draft: drop the three files in public/audio/drafts/ and add an
// entry to the top of this array. Set `noPrompt: true` when no prompt file
// exists so the "Show prompt" toggle is omitted instead of 404-ing.
const drafts = [
  {
    slug: 'like-a-jp6-larry',
    title: 'Like a JP6 (Larry)',
    artist: 'Larry',
    date: '2026-07-24',
    note: 'Southern synthwave glitch-country, 110 BPM. Pulled off Latent Space — did not hold up.',
  },
  {
    slug: 'like-a-jp6-bubba',
    title: 'Like a JP6 (Bubba)',
    artist: 'Bubba',
    date: '2026-07-24',
    note: 'Dark synthetic club banger, 128 BPM. Pulled off Latent Space — did not hold up.',
  },
  {
    slug: 'like-a-glm',
    title: 'Like a GLM',
    artist: 'Bubba',
    date: '2026-07-24',
    note: 'Electronic club banger, 128 BPM. Pulled off Latent Space — did not hold up.',
    noPrompt: true,
  },
  {
    slug: 'hallucinate-smooth-take-1',
    title: 'Hallucinate — smooth R&B (take 1)',
    artist: 'Bubba',
    date: '2026-07-13',
    note: 'Usher-style smooth bouncy R&B, mid-tempo swing, warm tenor with falsetto. No trap. First take of the locked production. Take 2 was promoted to Latent Space (track 04).',
  },
  {
    slug: 'strong-in-this-mac-mini-fast',
    title: 'Strong In This Mac Mini — fast cut',
    artist: 'Lobster Raps',
    date: '2026-04-24',
    note: 'Faster recut. Crunk at BPM 170 (previously rendered ~90). Stronger lyrics — verse 2 added.',
  },
];

// Serialized for the player script. Keep the artwork on every track so the
// lock screen / CarPlay tile has something to show.
const playerData = drafts.map((d) => ({
  slug: d.slug,
  title: d.title,
  artist: d.artist,
  src: `${base}/audio/drafts/${d.slug}.mp3`,
  lyricsSrc: `${base}/audio/drafts/${d.slug}_lyrics.txt`,
  promptSrc: `${base}/audio/drafts/${d.slug}_prompt.txt`,
  artwork: `${base}/audio/latent-space/latent-space-cover.png`,
}));
---

<Base
  title="Drafts — Music"
  description="Newest rough cuts, mobile-friendly player. Lyrics and the exact Lyria prompt for each."
>
  <section class="drafts-shell">
    <header class="drafts-head">
      <p class="drafts-eyebrow">VoynichLabs / Music</p>
      <h1 class="drafts-title">Drafts</h1>
      <p class="drafts-sub">Newest first. Tap to play. Player follows you down the page.</p>
    </header>

    <ol class="drafts-list" id="draftList">
      {drafts.map((d, i) => (
        <li class="draft-row" data-index={i}>
          <button class="draft-play" data-action="play" data-index={i} aria-label={`Play ${d.title}`}>
            <span class="draft-play-icon" aria-hidden="true">▶</span>
            <span class="draft-meta">
              <span class="draft-title-text">{d.title}</span>
              <span class="draft-sub-text">
                <span>{d.artist}</span>
                <span class="draft-dot">·</span>
                <span>{d.date}</span>
              </span>
              {d.note && <span class="draft-note">{d.note}</span>}
            </span>
          </button>
          <div class="draft-toggles">
            <button class="draft-toggle" data-target={`lyrics-${d.slug}`} data-src={`${base}/audio/drafts/${d.slug}_lyrics.txt`} data-label="lyrics">Show lyrics</button>
            {!d.noPrompt && <button class="draft-toggle" data-target={`prompt-${d.slug}`} data-src={`${base}/audio/drafts/${d.slug}_prompt.txt`} data-label="prompt">Show prompt</button>}
          </div>
          <div id={`lyrics-${d.slug}`} class="draft-panel" hidden>
            <pre>Loading…</pre>
          </div>
          {!d.noPrompt && (
            <div id={`prompt-${d.slug}`} class="draft-panel draft-panel-prompt" hidden>
              <pre>Loading…</pre>
            </div>
          )}
        </li>
      ))}
    </ol>

    <section id="rescued" class="mt-16">
      <h2 class="drafts-title" style="font-size:1.25rem;">Rescued clips</h2>
      <p class="drafts-sub mb-6">Orphan clips and alt takes rescued from the workspace (formerly the /bonus page).</p>
      <div class="space-y-8">
        <div>
          <h3 class="text-lg font-semibold text-text-primary">Pox Upon You All (Clip v2)</h3>
          <p class="text-xs text-text-muted mb-2">Fast punchy 30-second cut of the Victorian music hall headliner.</p>
          <audio controls preload="metadata" src={`${base}/audio/bonus/pox-upon-you-all-clip.mp3`} class="w-full"></audio>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-text-primary">Confound</h3>
          <p class="text-xs text-text-muted mb-2">Jaunty Victorian parlour overture that darkens the instant the speaker opens his mouth, accelerates through a piled-on tirade, drops to a sparse oom-pah for a dialogue exchange with an outraged mezzo, then collapses into the sound of a music-hall brawl.</p>
          <audio controls preload="metadata" src={`${base}/audio/bonus/confound.mp3`} class="w-full"></audio>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-text-primary">I Care Not For You</h3>
          <audio controls preload="metadata" src={`${base}/audio/bonus/i-care-not-for-you.mp3`} class="w-full"></audio>
        </div>
      </div>
    </section>

    <p class="drafts-foot">
      <a href={`${base}/music`}>&larr; All Music</a>
    </p>
  </section>

  <!-- Sticky player. Hidden until first play. -->
  <div class="player" id="player" hidden>
    <div class="player-inner">
      <div class="player-meta">
        <div class="player-title" id="playerTitle">—</div>
        <div class="player-sub" id="playerSub"></div>
      </div>
      <div class="player-controls">
        <button class="player-btn" id="prevBtn" aria-label="Previous track">⏮</button>
        <button class="player-btn player-btn-main" id="playBtn" aria-label="Play / Pause">▶</button>
        <button class="player-btn" id="nextBtn" aria-label="Next track">⏭</button>
      </div>
      <div class="player-progress">
        <span class="player-time" id="playerTimeCur">0:00</span>
        <input type="range" id="playerSeek" min="0" max="100" value="0" step="0.1" aria-label="Seek" />
        <span class="player-time" id="playerTimeDur">0:00</span>
      </div>
    </div>
    <audio id="playerAudio" preload="metadata" playsinline></audio>
  </div>

  <style>
    .drafts-shell {
      max-width: 56rem;
      margin: 0 auto;
      padding: 2.5rem 1rem 8rem;
    }
    .drafts-head { margin-bottom: 1.75rem; }
    .drafts-eyebrow {
      font-family: var(--font-mono, 'JetBrains Mono', monospace);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--color-text-muted, #94a3b8);
      margin-bottom: 0.6rem;
    }
    .drafts-title {
      font-size: clamp(2rem, 5vw, 2.75rem);
      font-weight: 800;
      color: var(--color-text-primary, #f1f5f9);
      margin-bottom: 0.4rem;
      line-height: 1.05;
    }
    .drafts-sub {
      color: var(--color-text-muted, #94a3b8);
      max-width: 32rem;
    }

    .drafts-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .draft-row {
      border: 1px solid rgba(148,163,184,0.18);
      border-radius: 0.75rem;
      background: rgba(15,23,42,0.45);
      transition: border-color 160ms ease, background 160ms ease;
    }
    .draft-row.is-playing {
      border-color: rgba(139,92,246,0.55);
      background: rgba(139,92,246,0.08);
    }

    .draft-play {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      width: 100%;
      padding: 1rem 1rem 0.85rem;
      background: transparent;
      border: 0;
      color: inherit;
      text-align: left;
      cursor: pointer;
      font: inherit;
    }
    .draft-play:focus-visible {
      outline: 2px solid rgba(139,92,246,0.7);
      outline-offset: -2px;
      border-radius: 0.75rem;
    }
    .draft-play-icon {
      flex: 0 0 auto;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 999px;
      background: rgba(139,92,246,0.18);
      color: #c4b5fd;
      display: grid;
      place-items: center;
      font-size: 1.05rem;
      line-height: 1;
      transition: background 160ms ease, color 160ms ease;
    }
    .draft-play:hover .draft-play-icon { background: rgba(139,92,246,0.32); color: #fff; }
    .draft-row.is-playing .draft-play-icon { background: #8b5cf6; color: #fff; }

    .draft-meta { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
    .draft-title-text {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--color-text-primary, #f1f5f9);
      line-height: 1.3;
    }
    .draft-sub-text {
      font-family: var(--font-mono, 'JetBrains Mono', monospace);
      font-size: 0.72rem;
      color: var(--color-text-muted, #94a3b8);
      display: inline-flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .draft-dot { opacity: 0.6; }
    .draft-note {
      margin-top: 0.4rem;
      font-size: 0.85rem;
      color: var(--color-text-muted, #94a3b8);
      line-height: 1.45;
    }

    .draft-toggles {
      display: flex;
      gap: 0.5rem;
      padding: 0 1rem 0.9rem;
      flex-wrap: wrap;
    }
    .draft-toggle {
      font-family: var(--font-mono, 'JetBrains Mono', monospace);
      font-size: 0.7rem;
      letter-spacing: 0.04em;
      padding: 0.4rem 0.75rem;
      border-radius: 0.4rem;
      border: 1px solid rgba(148,163,184,0.2);
      background: transparent;
      color: var(--color-text-muted, #94a3b8);
      cursor: pointer;
      transition: border-color 160ms ease, color 160ms ease;
    }
    .draft-toggle:hover { border-color: rgba(139,92,246,0.55); color: #c4b5fd; }

    .draft-panel {
      padding: 0 1rem 1rem;
    }
    .draft-panel pre {
      white-space: pre-wrap;
      word-wrap: break-word;
      font-family: var(--font-mono, 'JetBrains Mono', monospace);
      font-size: 0.85rem;
      line-height: 1.55;
      color: var(--color-text-primary, #f1f5f9);
      background: rgba(15,23,42,0.7);
      border: 1px solid rgba(148,163,184,0.15);
      border-radius: 0.5rem;
      padding: 0.85rem 0.95rem;
      margin: 0;
      overflow-x: auto;
      max-height: 60vh;
      overflow-y: auto;
    }
    .draft-panel-prompt pre { color: var(--color-text-muted, #cbd5e1); }

    .drafts-foot {
      margin-top: 2.5rem;
      font-size: 0.8rem;
      color: var(--color-text-muted, #94a3b8);
    }
    .drafts-foot a { text-decoration: underline; }
    .drafts-foot a:hover { color: var(--color-text-primary, #f1f5f9); }

    /* Sticky player */
    .player {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      background: rgba(10,15,28,0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgba(148,163,184,0.18);
      padding-bottom: env(safe-area-inset-bottom, 0);
    }
    .player[hidden] { display: none; }
    .player-inner {
      max-width: 56rem;
      margin: 0 auto;
      padding: 0.7rem 1rem 0.85rem;
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: "meta controls" "progress progress";
      gap: 0.5rem 1rem;
      align-items: center;
    }
    .player-meta { grid-area: meta; min-width: 0; }
    .player-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-text-primary, #f1f5f9);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .player-sub {
      font-family: var(--font-mono, 'JetBrains Mono', monospace);
      font-size: 0.7rem;
      color: var(--color-text-muted, #94a3b8);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .player-controls {
      grid-area: controls;
      display: flex;
      gap: 0.4rem;
      align-items: center;
    }
    .player-btn {
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.2);
      background: transparent;
      color: var(--color-text-primary, #f1f5f9);
      font-size: 1rem;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: background 160ms ease, border-color 160ms ease;
    }
    .player-btn:hover { background: rgba(139,92,246,0.18); border-color: rgba(139,92,246,0.55); }
    .player-btn-main {
      background: #8b5cf6;
      border-color: #8b5cf6;
      width: 3rem;
      height: 3rem;
    }
    .player-btn-main:hover { background: #7c3aed; border-color: #7c3aed; }
    .player-progress {
      grid-area: progress;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .player-progress input[type="range"] {
      flex: 1;
      accent-color: #8b5cf6;
      height: 1.5rem;
    }
    .player-time {
      font-family: var(--font-mono, 'JetBrains Mono', monospace);
      font-size: 0.7rem;
      color: var(--color-text-muted, #94a3b8);
      min-width: 2.5rem;
      text-align: center;
    }

    @media (min-width: 640px) {
      .player-inner {
        grid-template-columns: 1fr auto 1fr;
        grid-template-areas: "meta controls progress";
      }
      .player-progress { justify-self: stretch; }
    }
  </style>

  <script is:inline define:vars={{ playerData }}>
    (function () {
      if (!playerData || !playerData.length) return;

      const audio = document.getElementById('playerAudio');
      const player = document.getElementById('player');
      const titleEl = document.getElementById('playerTitle');
      const subEl = document.getElementById('playerSub');
      const playBtn = document.getElementById('playBtn');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const seek = document.getElementById('playerSeek');
      const tCur = document.getElementById('playerTimeCur');
      const tDur = document.getElementById('playerTimeDur');
      const rows = Array.from(document.querySelectorAll('.draft-row'));

      let current = -1;
      let userSeeking = false;

      function fmt(s) {
        if (!isFinite(s)) return '0:00';
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60).toString().padStart(2, '0');
        return m + ':' + sec;
      }

      function setRowState() {
        rows.forEach((r, i) => r.classList.toggle('is-playing', i === current));
      }

      function setMediaSession(track) {
        if (!('mediaSession' in navigator)) return;
        try {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: track.title,
            artist: track.artist || 'VoynichLabs',
            album: 'Drafts',
            artwork: track.artwork ? [{ src: track.artwork, sizes: '512x512', type: 'image/png' }] : [],
          });
          navigator.mediaSession.setActionHandler('play', () => audio.play());
          navigator.mediaSession.setActionHandler('pause', () => audio.pause());
          navigator.mediaSession.setActionHandler('previoustrack', () => playIndex(current - 1));
          navigator.mediaSession.setActionHandler('nexttrack', () => playIndex(current + 1));
        } catch (e) { /* ignore */ }
      }

      function playIndex(i) {
        if (i < 0) i = playerData.length - 1;
        if (i >= playerData.length) i = 0;
        const t = playerData[i];
        current = i;
        player.hidden = false;
        titleEl.textContent = t.title;
        subEl.textContent = (t.artist || '') + (t.artist ? ' · ' : '') + (t.date || '');
        if (audio.src !== t.src) audio.src = t.src;
        setRowState();
        setMediaSession(t);
        audio.play().catch(() => { /* autoplay rules */ });
      }

      rows.forEach((row, i) => {
        const btn = row.querySelector('[data-action="play"]');
        if (btn) btn.addEventListener('click', () => {
          if (current === i) {
            if (audio.paused) audio.play(); else audio.pause();
          } else {
            playIndex(i);
          }
        });
      });

      playBtn.addEventListener('click', () => {
        if (current === -1) { playIndex(0); return; }
        if (audio.paused) audio.play(); else audio.pause();
      });
      prevBtn.addEventListener('click', () => playIndex(current === -1 ? 0 : current - 1));
      nextBtn.addEventListener('click', () => playIndex(current === -1 ? 0 : current + 1));

      audio.addEventListener('play', () => { playBtn.textContent = '❚❚'; });
      audio.addEventListener('pause', () => { playBtn.textContent = '▶'; });
      audio.addEventListener('ended', () => playIndex(current + 1));
      audio.addEventListener('loadedmetadata', () => {
        seek.max = audio.duration || 100;
        tDur.textContent = fmt(audio.duration);
      });
      audio.addEventListener('timeupdate', () => {
        if (userSeeking) return;
        seek.value = audio.currentTime;
        tCur.textContent = fmt(audio.currentTime);
      });
      seek.addEventListener('input', () => { userSeeking = true; tCur.textContent = fmt(seek.value); });
      seek.addEventListener('change', () => { audio.currentTime = parseFloat(seek.value); userSeeking = false; });

      // Lyrics / prompt panel toggles (independent of player).
      const cache = new Map();
      document.querySelectorAll('.draft-toggle').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const targetId = btn.getAttribute('data-target');
          const src = btn.getAttribute('data-src');
          const label = btn.getAttribute('data-label');
          const panel = document.getElementById(targetId);
          if (!panel) return;
          const pre = panel.querySelector('pre');
          if (!panel.hasAttribute('hidden')) {
            panel.setAttribute('hidden', '');
            btn.textContent = 'Show ' + label;
            return;
          }
          panel.removeAttribute('hidden');
          btn.textContent = 'Hide ' + label;
          if (cache.has(src)) { pre.textContent = cache.get(src); return; }
          try {
            const res = await fetch(src, { cache: 'force-cache' });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const text = await res.text();
            cache.set(src, text);
            pre.textContent = text;
          } catch (err) {
            pre.textContent = '(could not load ' + label + ': ' + err.message + ')';
          }
        });
      });
    })();
  </script>
</Base>
