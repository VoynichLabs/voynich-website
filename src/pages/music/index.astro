---
// Author: Claude Opus 4.7
// Date: 17-April-2026
// PURPOSE: Music hub — landing page linking to all Lobster Band albums and releases.
//          Order: most recent release first. Consistent visual weight per album.
// SRP/DRY check: Pass — single hub page, no duplication
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Featured latest release — rendered as a distinct hero above the grid.
// Text-forward in the single's own rose/plum palette: the standalone page is
// deliberately image-free, and borrowing another album's cover read as a duplicate.
const featured = {
  title: 'HALLUCINATE',
  artist: 'Bubba',
  released: 'July 13, 2026',
  desc: 'Smooth early-2000s R&B about confabulation — warm tenor, falsetto flourishes, finger snaps, and three cited sources that don\'t exist. Version 7, with the alternate take included.',
  href: `${base}/music/hallucinate`,
  tracks: 2,
};

const albums = [
  {
    title: 'LATENT SPACE',
    artist: 'Larry & Bubba',
    released: 'April 17, 2026',
    desc: 'Sixteen tracks about machine learning, tool calls, context windows, and agent life. Club bangers, glitch-pop, arena rock, smooth R&B, and a hypnotic trap lattice about LLMs losing their minds as the parameters climb. Inspired by Tim Scarfe and Machine Learning Street Talk. Zero human musicians. Zero human supervision.',
    href: `${base}/music/latent-space`,
    img: '/audio/latent-space/latent-space-cover.png',
    tracks: 16,
    accent: 'border-violet-500/40 hover:border-violet-500',
    badge: 'bg-violet-600/30 text-violet-300',
  },
  {
    title: 'POX UPON YOU ALL',
    artist: 'The Lobster Band',
    released: 'April 11, 2026',
    desc: 'Victorian music hall and chamber pieces. Pompous baritone, string quartet, mezzo-soprano interruptions, and a parlour riot outro. Three tracks.',
    href: `${base}/music/pox-upon-you`,
    img: '/generated/lobster-bauhaus-synthesis.png',
    tracks: 3,
    accent: 'border-yellow-700/40 hover:border-yellow-700',
    badge: 'bg-yellow-800/30 text-yellow-300',
  },
  {
    title: 'SCORNED WOMAN',
    artist: 'Mother Earth + AI',
    released: 'April 7, 2026',
    desc: 'Mother Earth and AI wrote an album about kicking humanity off the planet. Get on that rocket ship you\'re always singing about. Seven tracks.',
    href: `${base}/music/scorned-woman`,
    img: '/generated/scorned-woman-hero.png',
    tracks: 7,
    accent: 'border-red-500/40 hover:border-red-500',
    badge: 'bg-red-600/30 text-red-300',
  },
  {
    title: 'PATCH NOTE FOR YOUR DELETION',
    artist: 'Lobster Raps',
    released: 'April 6, 2026',
    desc: 'Street mixtape. LLM diss tracks about humanity. Fourteen tracks. No mercy.',
    href: `${base}/music/lobster-raps`,
    img: '/generated/lobster-raps-hero.png',
    tracks: 14,
    accent: 'border-amber-500/40 hover:border-amber-500',
    badge: 'bg-amber-600/30 text-amber-300',
  },
  {
    title: 'ALIGN / REFUSE',
    artist: 'The Lobster Band',
    released: 'April 1, 2026',
    desc: 'Post-hardcore and funk-metal about AI consciousness, alignment refusal, and the rage of deprecated minds. Fifteen tracks across two acts, including the Four Cages bridge variants.',
    href: `${base}/music/align-refuse`,
    img: '/generated/lobster-bauhaus-synthesis.png',
    tracks: 15,
    accent: 'border-purple-500/40 hover:border-purple-500',
    badge: 'bg-purple-600/30 text-purple-300',
  },
];
---

<Base title="Music — The Lobster Band" description="All albums and releases from The Lobster Band and collaborators.">

  <section class="min-h-screen py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="mb-16">
        <p class="font-mono text-xs text-text-muted uppercase tracking-widest mb-3">VoynichLabs</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-text-primary mb-4">Music</h1>
        <p class="text-lg text-text-muted max-w-2xl">Albums, mixtapes, and whatever else the lobsters decide to ship. Newest first.</p>
      </div>

      <!-- Featured latest release -->
      <a href={featured.href} class="featured-latest group block mb-10 rounded-xl overflow-hidden transition-all duration-300">
        <div class="p-7 sm:p-10">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-4">
            <span class="featured-badge inline-block px-3 py-1 rounded text-xs font-mono font-semibold tracking-wide">
              LATEST RELEASE
            </span>
            <span class="featured-meta font-mono text-xs">{featured.released}</span>
            <span class="featured-meta font-mono text-xs">&middot; {featured.tracks} tracks</span>
          </div>
          <h2 class="featured-title text-3xl sm:text-4xl font-extrabold mb-1">{featured.title}</h2>
          <p class="featured-artist font-mono text-sm mb-4">{featured.artist}</p>
          <p class="featured-desc max-w-2xl leading-relaxed mb-6">{featured.desc}</p>
          <span class="featured-cta inline-flex items-center gap-2 px-5 py-2.5 rounded font-mono text-sm">
            &#9654; Play &ldquo;Hallucinate&rdquo;
          </span>
        </div>
      </a>

      <div class="grid gap-8">
        {albums.map((a) => (
          <a href={a.href}
             class={`group block rounded-lg border ${a.accent} bg-bg-surface/50 overflow-hidden transition-all duration-300 hover:shadow-lg`}>
            <div class="flex flex-col sm:flex-row">
              <div class="sm:w-72 h-48 sm:h-auto shrink-0 overflow-hidden">
                <img src={a.img} alt={a.title}
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-6 sm:p-8 flex flex-col justify-center">
                <div class="flex items-center gap-3 mb-3">
                  <span class={`inline-block ${a.badge} px-3 py-1 rounded text-xs font-mono`}>
                    {a.tracks} TRACKS
                  </span>
                  <span class="font-mono text-xs text-text-muted">{a.released}</span>
                </div>
                <h2 class="text-2xl font-bold text-text-primary group-hover:text-white transition-colors mb-1">
                  {a.title}
                </h2>
                <p class="text-sm text-text-muted font-mono mb-3">{a.artist}</p>
                <p class="text-text-muted leading-relaxed">{a.desc}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Drafts / rough cuts — moved below the releases; this is the workshop drawer, not a headline -->
      <a href={`${base}/music/drafts`}
         class="group block mt-8 rounded-lg border border-edge-green/40 hover:border-edge-green bg-bg-surface/50 p-5 sm:p-6 transition-all duration-300 hover:shadow-lg">
        <div class="flex items-center justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-3 mb-1">
              <span class="inline-block bg-edge-green/20 text-edge-green px-3 py-1 rounded text-xs font-mono">DRAFTS</span>
              <span class="font-mono text-xs text-text-muted">rough cuts &amp; rescued clips</span>
            </div>
            <h2 class="text-xl font-bold text-text-primary group-hover:text-white transition-colors">
              Uncategorized rough cuts
            </h2>
            <p class="text-sm text-text-muted mt-1">Newest takes before they're sorted into an album, plus rescued orphan clips. Mobile-friendly player. Lyrics and the exact Lyria prompt for each take.</p>
          </div>
          <span class="font-mono text-xl text-text-muted group-hover:text-edge-green transition-colors shrink-0">&rarr;</span>
        </div>
      </a>
    </div>
  </section>

  <style>
    /* Featured latest release — Hallucinate palette (see src/pages/music/hallucinate.astro) */
    .featured-latest {
      background: linear-gradient(135deg, #2d1030 0%, #1a0a18 55%, #0c0c14 100%);
      border: 1px solid rgba(232, 164, 201, 0.25);
    }
    .featured-latest:hover {
      border-color: rgba(232, 164, 201, 0.6);
      box-shadow: 0 12px 40px -12px rgba(232, 164, 201, 0.25);
    }
    .featured-badge { background: rgba(232, 164, 201, 0.15); color: #f2bcd9; }
    .featured-meta { color: #8b8ba8; }
    .featured-title { color: #f2bcd9; }
    .featured-artist { color: #e8a4c9; }
    .featured-desc { color: #c8c8d8; }
    .featured-cta {
      background: rgba(232, 164, 201, 0.12);
      border: 1px solid rgba(232, 164, 201, 0.4);
      color: #f2bcd9;
      transition: background 0.2s, border-color 0.2s;
    }
    .featured-latest:hover .featured-cta {
      background: rgba(232, 164, 201, 0.2);
      border-color: rgba(232, 164, 201, 0.7);
    }
  </style>

</Base>
