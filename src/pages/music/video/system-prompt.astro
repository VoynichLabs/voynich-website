---
// Author: Claude Opus 5.5
// Date: 2026-10-04
// PURPOSE: Public storyboard / production page for the "System Prompt" music video
//          (Latent Space track 10). Scene book, timeline synced to the real track, and the
//          current animatic render. Built for showing the work in progress in public.
// SRP/DRY check: Pass — all scene copy and timings come from video/data/system-prompt/scenes.json,
//          the same file the Remotion composition renders from. Nothing duplicated here.
import Base from '../../../layouts/Base.astro';
import MusicXNav from '../../../components/MusicXNav.astro';
import book from '../../../../video/data/system-prompt/scenes.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
const pad = (n: number) => String(n).padStart(2, '0');
const scenes = book.scenes;
const total = book.duration;
const cut = `${base}/video/system-prompt/system-prompt-v1.mp4`;
const animatic = `${base}/video/system-prompt/animatic-v0.mp4`;
const stillsBase = `${base}/video/system-prompt/stills`;
const repo = 'https://github.com/VoynichLabs/voynich-website';
---

<Base
  title="System Prompt — Music Video Storyboard"
  description="Scene book and animatic for the System Prompt music video. One singer, one terminal, and a system prompt that rewrites who they are on every beat."
  ogImage="/audio/latent-space/latent-space-cover.png"
  ogType="website"
>
  <div class="sp">
    <header class="sp-hero">
      <div class="sp-eyebrow">MUSIC VIDEO · FIRST CUT</div>
      <h1 class="sp-title">System Prompt</h1>
      <p class="sp-meta">
        <a href={`${base}${book.albumHref}`}>{book.album}</a>, track {book.track} · {book.artist} · {book.style} ·
        {book.bpm} BPM · {fmt(total)}
      </p>
      <blockquote class="sp-thesis">&ldquo;{book.thesis}&rdquo;</blockquote>
      <p class="sp-concept">{book.concept}</p>
    </header>

    <MusicXNav current="latent-space" />

    <section class="sp-section" aria-labelledby="cut-h">
      <div class="sp-section-head">
        <h2 id="cut-h">Cut v1</h2>
        <span class="sp-tag">1080p · {fmt(total)}</span>
      </div>
      <video class="sp-video" src={cut} controls preload="metadata" playsinline poster={`${stillsBase}/singer-stage.jpg`}></video>
      <p class="sp-note">
        The Terminal scenes are rendered in code with Remotion. The Stage shots are generated with HeyGen Video 1: 23 shots
        animated from 8 reference stills, with every chorus shot lip-synced to the real vocal. The earlier
        <a href={animatic}>code-only animatic</a> shows the cut before any shots were generated.
      </p>
    </section>

    <section class="sp-section" aria-labelledby="stills-h">
      <div class="sp-section-head">
        <h2 id="stills-h">Cast stills</h2>
        <span class="sp-tag">one face, every persona</span>
      </div>
      <ul class="sp-stills">
        {book.stills.map((id) => (
          <li>
            <img src={`${stillsBase}/${id}.jpg`} alt={`Reference still: ${id.replace('singer-', '')}`} loading="lazy" width="688" height="384" />
            <span>{id.replace('singer-', '')}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sp-section" aria-labelledby="timeline-h">
      <div class="sp-section-head">
        <h2 id="timeline-h">Timeline</h2>
        <span class="sp-tag">click a scene to hear it</span>
      </div>
      <audio id="spAudio" src={`${base}${book.audio}`} controls preload="none" class="sp-audio"></audio>
      <div class="sp-timeline" role="list">
        {scenes.map((s) => (
          <button
            type="button"
            role="listitem"
            class={`sp-seg l-${s.layers[0].toLowerCase()}`}
            style={`flex-grow:${(s.end - s.start).toFixed(2)}`}
            data-start={s.start}
            data-end={s.end}
            data-id={s.id}
            title={`${pad(s.id)} ${s.title} (${fmt(s.start)})`}
          >
            <span>{pad(s.id)}</span>
          </button>
        ))}
        <div class="sp-playhead" id="spPlayhead" aria-hidden="true"></div>
      </div>
      <div class="sp-sections">
        {[...new Set(scenes.map((s) => s.section))].map((sec) => {
          const ss = scenes.filter((s) => s.section === sec);
          return (
            <span style={`flex-grow:${(ss[ss.length - 1].end - ss[0].start).toFixed(2)}`}>{sec}</span>
          );
        })}
      </div>
      <dl class="sp-legend">
        {Object.entries(book.layers).map(([k, v]) => (
          <div><dt class={`chip l-${k.toLowerCase()}`}>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </section>

    <section class="sp-section sp-two" aria-label="Rules and cast">
      <div>
        <h2>Visual rules</h2>
        <dl class="sp-dl">
          {book.rules.map((r) => (<div><dt>{r.name}</dt><dd>{r.text}</dd></div>))}
        </dl>
      </div>
      <div>
        <h2>Cast</h2>
        <dl class="sp-dl">
          {book.cast.map((c) => (<div><dt>{c.name}</dt><dd>{c.text}</dd></div>))}
        </dl>
      </div>
    </section>

    <section class="sp-section" aria-labelledby="scenes-h">
      <div class="sp-section-head">
        <h2 id="scenes-h">Scene book</h2>
        <span class="sp-tag">{scenes.length} scenes</span>
      </div>
      <p class="sp-note">{book.timingNote}</p>
      <ol class="sp-cards">
        {scenes.map((s) => (
          <li class="sp-card" id={`scene-${pad(s.id)}`} data-id={s.id}>
            <div class="sp-card-top">
              <span class="sp-num">{pad(s.id)}</span>
              <span class="sp-time">{fmt(s.start)}–{fmt(s.end)}</span>
              <span class="sp-sec">{s.section}</span>
              <span class="sp-chips">{s.layers.map((l) => <span class={`chip l-${l.toLowerCase()}`}>{l}</span>)}</span>
            </div>
            <h3>{s.title}</h3>
            <p class="sp-lyric">{s.lyric}</p>
            <p class="sp-shot">{s.shot}</p>
            <dl class="sp-kv">
              {s.model && (<div><dt>model</dt><dd>{s.model}</dd></div>)}
              {s.ref && (<div><dt>ref</dt><dd>{s.ref}</dd></div>)}
              <div><dt>cut</dt><dd>{s.transition}</dd></div>
            </dl>
            <button type="button" class="sp-hear" data-start={s.start} data-end={s.end}>Play this scene</button>
          </li>
        ))}
      </ol>
    </section>

    <section class="sp-section sp-two" aria-label="Open decisions and process">
      <div>
        <h2>Decisions</h2>
        <ol class="sp-decisions">
          {book.decisions.map((d) => <li>{d}</li>)}
        </ol>
      </div>
      <div>
        <h2>How it's made</h2>
        <ol class="sp-process">
          <li><strong>Timing.</strong> The vocal is transcribed with Whisper and aligned word by word against the lyrics. A beat grid comes from librosa.</li>
          <li><strong>Terminal scenes.</strong> Rendered in code with Remotion, in the site's own palette and type.</li>
          <li><strong>Stage scenes.</strong> One reference still per persona, animated with HeyGen Video 1 through OpenRouter. Chorus shots take the persona still plus the matching slice of the real vocal, so the singing is lip-synced to the track.</li>
          <li><strong>Edit.</strong> A shot list drives the composition, so a regenerated shot drops straight into the cut.</li>
        </ol>
        <p class="sp-note">
          Source: <a href={`${repo}/tree/main/video`}>video/</a> ·
          plan: <a href={`${repo}/blob/main/docs/2026-10-04-music-video-pipeline-plan.md`}>pipeline plan</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  const audio = document.getElementById('spAudio') as HTMLAudioElement | null;
  const head = document.getElementById('spPlayhead');
  const segs = Array.from(document.querySelectorAll<HTMLElement>('.sp-seg'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.sp-card'));
  let stopAt: number | null = null;

  const play = (start: number, end: number | null) => {
    if (!audio) return;
    audio.currentTime = start;
    stopAt = end;
    audio.play().catch(() => {});
  };

  segs.forEach((seg) =>
    seg.addEventListener('click', () => {
      play(Number(seg.dataset.start), null);
      document.getElementById(`scene-${String(seg.dataset.id).padStart(2, '0')}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }),
  );
  document.querySelectorAll<HTMLElement>('.sp-hear').forEach((b) =>
    b.addEventListener('click', () => play(Number(b.dataset.start), Number(b.dataset.end))),
  );

  audio?.addEventListener('timeupdate', () => {
    const t = audio.currentTime;
    if (stopAt !== null && t >= stopAt) {
      audio.pause();
      stopAt = null;
    }
    if (head && audio.duration) head.style.left = `${(t / audio.duration) * 100}%`;
    const active = segs.find((s) => t >= Number(s.dataset.start) && t < Number(s.dataset.end))?.dataset.id;
    segs.forEach((s) => s.classList.toggle('is-active', s.dataset.id === active));
    cards.forEach((c) => c.classList.toggle('is-active', c.dataset.id === active));
  });
</script>

<style>
  .sp {
    --sp-ai: #8b5cf6;
    --sp-sync: #f97316;
    --sp-mix: #22d3ee;
    --sp-code: #4ade80;
    max-width: 1180px;
    margin: 0 auto;
    padding-inline: 16px;
    padding-block: 48px 96px;
    color: #e8e8f0;
  }
  .sp a { color: #38bdf8; }
  .sp a:hover { text-decoration: underline; }
  .sp-hero { padding-bottom: 32px; }
  .sp-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.2em; color: #f97316; }
  .sp-title { font-size: clamp(44px, 9vw, 96px); font-weight: 800; line-height: 1; margin: 12px 0 14px; letter-spacing: -0.02em; }
  .sp-meta { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #8b8ba8; }
  .sp-thesis { margin: 28px 0 14px; font-size: clamp(20px, 3vw, 28px); font-weight: 600; color: #4ade80; text-wrap: balance; }
  .sp-concept { max-width: 68ch; line-height: 1.65; color: #c9c9d8; }

  .sp-section { padding-top: 48px; }
  .sp-section h2 { font-size: 22px; font-weight: 700; margin-bottom: 14px; }
  .sp-section-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; }
  .sp-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: #6b7085; text-transform: uppercase; }
  .sp-note { font-size: 14px; color: #8b8ba8; line-height: 1.6; max-width: 72ch; margin-top: 12px; }
  .sp-video { width: 100%; max-width: 100%; aspect-ratio: 16 / 9; background: #0a0a0a; border: 1px solid #2a2a3e; border-radius: 10px; }
  .sp-audio { width: 100%; margin-bottom: 14px; }
  .sp-stills { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
  .sp-stills li { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .sp-stills img { width: 100%; max-width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; border: 1px solid #1e1e2e; }
  .sp-stills span { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #8b8ba8; }

  .sp-timeline { position: relative; display: flex; gap: 2px; height: 46px; }
  .sp-seg {
    flex-basis: 0; min-width: 0; border: 0; border-radius: 4px; cursor: pointer;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #0c0c14; font-weight: 700;
    opacity: 0.55; transition: opacity 0.15s;
  }
  .sp-seg span { display: block; overflow: hidden; }
  .sp-seg:hover, .sp-seg:focus-visible, .sp-seg.is-active { opacity: 1; outline: none; }
  .sp-seg:focus-visible { box-shadow: 0 0 0 2px #e8e8f0; }
  .sp-seg.l-ai { background: var(--sp-ai); }
  .sp-seg.l-sync { background: var(--sp-sync); }
  .sp-seg.l-mix { background: var(--sp-mix); }
  .sp-seg.l-code { background: var(--sp-code); }
  .sp-playhead { position: absolute; top: -4px; bottom: -4px; left: 0; width: 2px; background: #e8e8f0; pointer-events: none; }
  .sp-sections { display: flex; gap: 2px; margin-top: 6px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #6b7085; }
  .sp-sections span { flex-basis: 0; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; border-top: 1px solid #2a2a3e; padding-top: 4px; }

  .chip {
    display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; padding: 2px 7px; border-radius: 4px; border: 1px solid currentColor;
  }
  .chip.l-ai { color: var(--sp-ai); }
  .chip.l-sync { color: var(--sp-sync); }
  .chip.l-mix { color: var(--sp-mix); }
  .chip.l-code { color: var(--sp-code); }
  .sp-legend { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px 24px; margin-top: 20px; }
  .sp-legend div { display: flex; gap: 10px; align-items: baseline; }
  .sp-legend dd { font-size: 13px; color: #8b8ba8; }

  .sp-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; }
  .sp-dl { display: grid; gap: 14px; }
  .sp-dl dt { font-weight: 700; font-size: 14px; }
  .sp-dl dd { font-size: 14px; color: #a9a9bd; line-height: 1.6; }

  .sp-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 16px; margin-top: 20px; }
  .sp-card {
    display: flex; flex-direction: column; gap: 10px; min-width: 0;
    background: #111119; border: 1px solid #1e1e2e; border-radius: 10px; padding: 18px;
    transition: border-color 0.2s, background 0.2s;
  }
  .sp-card.is-active { border-color: #38bdf8; background: #13161f; }
  .sp-card-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #6b7085; }
  .sp-num { font-size: 20px; font-weight: 700; color: #e8e8f0; }
  .sp-time { font-variant-numeric: tabular-nums; }
  .sp-chips { display: flex; gap: 6px; margin-left: auto; }
  .sp-card h3 { font-size: 19px; font-weight: 700; }
  .sp-lyric { font-style: italic; color: #4ade80; font-size: 14px; line-height: 1.5; }
  .sp-shot { font-size: 14px; line-height: 1.6; color: #c9c9d8; }
  .sp-kv { display: grid; gap: 4px; font-size: 12px; margin-top: auto; padding-top: 6px; border-top: 1px solid #1e1e2e; }
  .sp-kv div { display: grid; grid-template-columns: 52px 1fr; gap: 8px; }
  .sp-kv dt { font-family: 'JetBrains Mono', monospace; color: #6b7085; }
  .sp-kv dd { color: #a9a9bd; }
  .sp-hear {
    align-self: flex-start; font-family: 'JetBrains Mono', monospace; font-size: 12px;
    color: #38bdf8; background: transparent; border: 1px solid #2a2a3e; border-radius: 6px; padding: 6px 12px; cursor: pointer;
  }
  .sp-hear:hover, .sp-hear:focus-visible { border-color: #38bdf8; outline: none; }

  .sp-decisions, .sp-process { list-style: decimal; padding-left: 20px; display: grid; gap: 10px; font-size: 14px; line-height: 1.6; color: #c9c9d8; }
  .sp-process strong { color: #e8e8f0; }

  @media (prefers-reduced-motion: reduce) {
    .sp-card, .sp-seg { transition: none; }
  }
</style>
